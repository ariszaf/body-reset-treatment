# Umami analytics (cookieless — no consent banner needed)
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# Contact form → Polarzee hosted forms (forms.polarzee.com). No API key here —
# the site key lives in src/content/site.ts (formSiteKey); origin is allow-listed
# server-side. Register the site's domain + key at forms.polarzee.com first.

# Optional: webhook URL for runtime error alerts (Discord/Slack/Google Sheets webhook).
# Leave empty for console-only logging.
PUBLIC_ERROR_WEBHOOK=
