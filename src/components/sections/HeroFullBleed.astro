---
/**
 * HeroFullBleed — the opening frame.
 *
 * Full-bleed photography filling an entire screen, with a quiet line of type
 * sitting low in the frame and a scroll cue beneath it. The logotype is NOT
 * repeated here: it already sits in the bar a few centimetres above, and the
 * reference (nikoskoulis.com) keeps its hero almost wordless — a small link
 * and a chevron at the bottom, nothing in the middle.
 *
 * This carries the page h1. It is set small, light and widely tracked rather
 * than large: on a premium site the scale comes from the photograph and the
 * empty space, not from the type.
 *
 * ZERO JavaScript. With two or more frames the crossfade is CSS keyframes on
 * negative animation-delays, so every frame is already mid-cycle at first paint
 * — no black flash, no hydration wait, nothing to break if JS fails. With one
 * frame it is a still image and no animation is emitted at all.
 *
 * The delay math: with N frames each held for `holdSec`, frame i must reach its
 * "fully visible" keyframe (0%) at t = i·holdSec. An animation started at t=0
 * with delay D sits at phase (t−D)/cycle, so D = i·holdSec − cycle, i.e.
 * −((N−i) mod N)·holdSec. Frame 0 gets delay 0 and is visible on load.
 *
 * Props:
 *   slides      ImageEntry[] — one entry for a still hero, two+ to sequence
 *   title       the h1 line
 *   eyebrow     small label above it
 *   note        small line below the rule
 *   holdSec     seconds each frame is held (default 7)
 *   nextAnchor  id the bottom cue scrolls to
 */
import type { ImageEntry } from '@content/images';

interface Props {
  slides: ImageEntry[];
  title: string;
  eyebrow?: string;
  note?: string;
  holdSec?: number;
  nextAnchor?: string;
}

const { slides, title, eyebrow, note, holdSec = 7, nextAnchor } = Astro.props;

const N = slides.length;
const cycle = N * holdSec;
const isStill = N === 1;

// Percentages of the full cycle. `fade` is the crossfade overlap.
const fade = 5;
const slice = 100 / N;
const pOut = +(slice - fade).toFixed(4);
const pGone = +slice.toFixed(4);
const pBack = +(100 - fade).toFixed(4);

const keyframes =
  `@keyframes brtHeroFade{0%{opacity:1}${pOut}%{opacity:1}${pGone}%{opacity:0}${pBack}%{opacity:0}100%{opacity:1}}` +
  `@keyframes brtHeroZoom{0%{transform:scale(1.02)}${pGone}%{transform:scale(1.08)}${pBack}%{transform:scale(1)}100%{transform:scale(1.02)}}`;

const delayFor = (i: number) => -(((N - i) % N) * holdSec);
---

{!isStill && <style is:inline set:html={keyframes} />}

<section class="hero">
  <div class="hero-frames">
    {slides.map((img, i) => (
      <figure
        class="hero-frame"
        style={isStill
          ? 'opacity:1'
          : `opacity:${i === 0 ? 1 : 0};animation:brtHeroFade ${cycle}s ${delayFor(i)}s infinite`}
      >
        <picture>
          {/* Art direction by ORIENTATION, not width: any portrait screen —
              phone or tablet held upright — gets the vertical crop, so the
              frame fills a whole screen without gutting the composition. */}
          {img.mobile && <source media="(orientation: portrait)" srcset={img.mobile} />}
          <img
            src={img.src}
            alt={img.alt}
            width={img.width}
            height={img.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding={i === 0 ? 'sync' : 'async'}
            style={isStill ? undefined : `animation:brtHeroZoom ${cycle}s ${delayFor(i)}s infinite`}
          />
        </picture>
      </figure>
    ))}
  </div>

  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-content">
    {eyebrow && <p class="hero-eyebrow" style="--i:0">{eyebrow}</p>}
    <h1 class="hero-title" style="--i:1">{title}</h1>
    <span class="hero-rule" style="--i:2" aria-hidden="true"></span>
    {note && <p class="hero-note" style="--i:3">{note}</p>}
  </div>

  {nextAnchor && (
    <a class="hero-cue" href={`#${nextAnchor}`} aria-label="Συνέχεια στο περιεχόμενο" style="--i:4">
      <span class="hero-cue-line" aria-hidden="true"></span>
      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
        <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
    </a>
  )}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: 100dvh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--color-primary-dark);
  }

  /* ------------------------------ frames ------------------------------ */
  .hero-frames { position: absolute; inset: 0; }
  .hero-frame { position: absolute; inset: 0; margin: 0; will-change: opacity; }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  /* Keeps the type legible without flattening the photograph. Weighted to the
     two bands that actually carry content — the logotype at the top and the
     type at the bottom — and left open through the middle so the room reads.
     The lower stops are heavy on purpose: the treatment table is the brightest
     object in the frame and it sits exactly behind the headline. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.42) 0%,
      rgb(0 0 0 / 0.10) 22%,
      rgb(0 0 0 / 0.04) 42%,
      rgb(0 0 0 / 0.40) 68%,
      rgb(0 0 0 / 0.66) 86%,
      rgb(0 0 0 / 0.74) 100%
    );
  }

  /* --------------------- entrance, keyed to the intro -------------------
     The type arrives AFTER the preloader veil has cleared, so the two never
     overlap. No JavaScript and no event listener is involved: the preloader
     stamps html.intro-ran before first paint, so the wait is simply a longer
     animation-delay on loads that opened with the veil.

       intro ran → veil dismisses at 2.2s, fades out over 1.1s → gone ≈3.3s
       otherwise → same session already, or JS disabled (no veil ever showed)

     It keys off `intro-ran`, NOT `preloader-active`: the latter is removed when
     the veil leaves, and a delay that disappears mid-flight makes the browser
     recompute elapsed time and snap the type in fully formed.

     `both` fill-mode holds the hidden state through the delay, and the whole
     thing degrades to "text visible" under reduced motion. */
  .hero { --hero-in: 0.6s; }
  html.intro-ran .hero { --hero-in: 3.5s; }

  .hero-content > *,
  .hero-cue {
    animation: heroIn 1.9s var(--reveal-ease) both;
    animation-delay: calc(var(--hero-in) + var(--i, 0) * 0.24s);
  }
  /* The hairline draws itself open rather than fading — slower, quieter. */
  .hero-rule { animation-name: heroRuleIn; }

  @keyframes heroIn {
    from { opacity: 0; filter: blur(7px); transform: translateY(14px); }
    to   { opacity: 1; filter: none;      transform: none; }
  }
  @keyframes heroRuleIn {
    from { opacity: 0; transform: scaleX(0); }
    to   { opacity: 1; transform: scaleX(1); }
  }

  /* ------------------------------ content ----------------------------- */
  .hero-content {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(6.5rem, 12vh, 9.5rem);   /* clears the scroll cue */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--stack-sm);
    padding-inline: var(--space-container);
    color: #fff;
  }
  .hero-eyebrow {
    margin: 0;
    font-size: var(--text-label);          /* 17px floor */
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    color: rgb(255 255 255 / 0.72);
  }
  .hero-title {
    margin: 0;
    max-width: 24ch;
    font-family: var(--font-heading);
    font-size: var(--text-h1);             /* 24 → 33px, per the type contract */
    font-weight: 200;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.45;
    text-wrap: balance;
  }
  .hero-rule {
    display: block;
    width: 2.5rem;
    height: 1px;                            /* px — hairline */
    background: rgb(255 255 255 / 0.45);
    margin-block-start: var(--stack-sm);
    transform-origin: center;
  }
  .hero-note {
    margin: 0;
    font-size: var(--text-label);
    color: rgb(255 255 255 / 0.78);
    letter-spacing: 0.04em;
  }

  /* ------------------------------ scroll cue --------------------------- */
  .hero-cue {
    position: absolute;
    inset-inline: 0;
    bottom: max(1.75rem, env(safe-area-inset-bottom));
    margin-inline: auto;
    width: 2.75rem;
    min-height: 2.75rem;                    /* ≥44px tap target */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
    color: rgb(255 255 255 / 0.72);
    text-decoration: none;
  }
  .hero-cue-line {
    display: block;
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(to bottom, transparent, currentColor);
  }
  @media (hover: hover) {
    .hero-cue { transition: color var(--transition-base), transform var(--transition-base); }
    .hero-cue:hover { color: #fff; transform: translateY(2px); }
  }

  /* --------------------------- reduced motion --------------------------
     Inline animations win the cascade, so these need !important: the hero
     collapses to a single still frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero-frame,
    .hero-frame img { animation: none !important; }
    .hero-frame { opacity: 0 !important; }
    .hero-frame:first-child { opacity: 1 !important; }
    .hero-frame img { transform: none !important; }
    /* The type is simply present — no delayed entrance to sit through. */
    .hero-content > *,
    .hero-cue { animation: none !important; opacity: 1; filter: none; transform: none; }
  }
</style>
