---
/**
 * HeroFullBleed — the opening frame.
 *
 * Full-bleed photography filling an entire screen, with the logotype forming
 * low in the frame and a scroll cue beneath it. No headline type: the mark
 * draws itself in, holds, leaves and draws again on a slow loop, so the frame
 * is never busy and never quite static either.
 *
 * This still carries the page h1 — as text, in .sr-only. A graphic is not a
 * heading: crawlers do not reliably read an aria-label on inline SVG as heading
 * text, so removing the visible line without leaving real text behind would cost
 * the page its only h1 and the keywords in it.
 *
 * ZERO JavaScript. With two or more frames the crossfade is CSS keyframes on
 * negative animation-delays, so every frame is already mid-cycle at first paint
 * — no black flash, no hydration wait, nothing to break if JS fails. With one
 * frame it is a still image and no animation is emitted at all.
 *
 * The delay math: with N frames each held for `holdSec`, frame i must reach its
 * "fully visible" keyframe (0%) at t = i·holdSec. An animation started at t=0
 * with delay D sits at phase (t−D)/cycle, so D = i·holdSec − cycle, i.e.
 * −((N−i) mod N)·holdSec. Frame 0 gets delay 0 and is visible on load.
 *
 * Props:
 *   slides      ImageEntry[] — one entry for a still hero, two+ to sequence
 *   title       the h1 line (screen readers + search engines; not painted)
 *   ink         'light' (white, over a dark photo) | 'dark' (page ink, over a
 *               high-key one). Everything keys off this: the mark, the cue, the
 *               scrim's direction, and the colour the nav bar takes while it
 *               floats over the frame.
 *   markY       where the logotype's centre sits, top-down. The photograph
 *               decides this — it belongs wherever the frame is empty.
 *   markYPortrait
 *               the same, for the vertical crop. A separate value because it is
 *               a separate PHOTOGRAPH: the art direction switches by orientation
 *               (see the <source> below), and the two frames are empty in
 *               different places. Falls back to markY when not given.
 *   holdSec     seconds each frame is held (default 7)
 *   nextAnchor  id the bottom cue scrolls to
 */
import type { ImageEntry } from '@content/images';
import BrandMark from '@components/BrandMark.astro';

interface Props {
  slides: ImageEntry[];
  title: string;
  ink?: 'light' | 'dark';
  markY?: string;
  markYPortrait?: string;
  holdSec?: number;
  nextAnchor?: string;
}

const { slides, title, ink = 'light', markY, markYPortrait, holdSec = 7, nextAnchor } = Astro.props;

const N = slides.length;
const cycle = N * holdSec;
const isStill = N === 1;

// Percentages of the full cycle. `fade` is the crossfade overlap.
const fade = 5;
const slice = 100 / N;
const pOut = +(slice - fade).toFixed(4);
const pGone = +slice.toFixed(4);
const pBack = +(100 - fade).toFixed(4);

const keyframes =
  `@keyframes brtHeroFade{0%{opacity:1}${pOut}%{opacity:1}${pGone}%{opacity:0}${pBack}%{opacity:0}100%{opacity:1}}` +
  `@keyframes brtHeroZoom{0%{transform:scale(1.02)}${pGone}%{transform:scale(1.08)}${pBack}%{transform:scale(1)}100%{transform:scale(1.02)}}`;

const delayFor = (i: number) => -(((N - i) % N) * holdSec);
---

{!isStill && <style is:inline set:html={keyframes} />}

<section
  class:list={['hero', markY && 'hero--placed']}
  data-ink={ink}
  style={[
    markY && `--mark-y:${markY}`,
    markYPortrait && `--mark-y-portrait:${markYPortrait}`,
  ].filter(Boolean).join(';') || undefined}
>
  <div class="hero-frames">
    {slides.map((img, i) => (
      <figure
        class="hero-frame"
        style={isStill
          ? 'opacity:1'
          : `opacity:${i === 0 ? 1 : 0};animation:brtHeroFade ${cycle}s ${delayFor(i)}s infinite`}
      >
        <picture>
          {/* Art direction by ORIENTATION, not width: any portrait screen —
              phone or tablet held upright — gets the vertical crop, so the
              frame fills a whole screen without gutting the composition. */}
          {img.mobile && <source media="(orientation: portrait)" srcset={img.mobile} />}
          <img
            src={img.src}
            alt={img.alt}
            width={img.width}
            height={img.height}
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding={i === 0 ? 'sync' : 'async'}
            style={isStill ? undefined : `animation:brtHeroZoom ${cycle}s ${delayFor(i)}s infinite`}
          />
        </picture>
      </figure>
    ))}
  </div>

  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="hero-content">
    <h1 class="hero-h1">
      <span class="sr-only">{title}</span>
      {/* Decorative: the h1 above already carries the accessible name, so the
          mark must not be announced a second time. */}
      <span class="hero-mark"><BrandMark title="" draw /></span>
    </h1>
  </div>

  {nextAnchor && (
    <a class="hero-cue" href={`#${nextAnchor}`} aria-label="Συνέχεια στο περιεχόμενο">
      <span class="hero-cue-line" aria-hidden="true"></span>
      <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
        <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
      </svg>
    </a>
  )}
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    height: 100dvh;
    min-height: 34rem;
    overflow: hidden;
    background: var(--color-primary-dark);
  }
  /* The backdrop the opening plays against — and what shows through while the
     photograph is still arriving, so it has to be the page's own colour. */
  .hero[data-ink='dark'] { background: var(--color-bg); }

  /* ------------------------------ frames ------------------------------ */
  .hero-frames { position: absolute; inset: 0; }

  /* ------------------------- the opening ------------------------------
     The whole page opens here, and there is no veil over the top of it: the
     hero starts as a plain field of page colour, the logotype draws itself in
     the place it will stay, and the photograph then materialises behind it.

     Sequence (no JavaScript, no listener — just delays):
       0.35s  the mark begins to draw
       1.10s  the photograph starts to arrive, while the wordmark is still
              settling — overlapping reads as one gesture, not two
       2.62s  the mark is whole and stays whole
       3.20s  the photograph is fully there

     This REPLACES the full-screen veil on this page rather than adding to it.
     The veil held the screen for ~3.0s AND locked scrolling; this holds nothing
     — the page is readable and scrollable from the first frame. */
  .hero-frames { animation: heroPhotoIn 2.1s var(--reveal-ease) 1.1s both; }
  .hero-scrim  { animation: heroScrimIn 2.1s var(--reveal-ease) 1.1s both; }

  @keyframes heroPhotoIn {
    from { opacity: 0; transform: scale(1.035); }
    to   { opacity: 1; transform: none; }
  }
  @keyframes heroScrimIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  .hero-frame { position: absolute; inset: 0; margin: 0; will-change: opacity; }
  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }

  /* ------------------------- the slow breath ---------------------------
     The frame drifts in and back out, 20 seconds each way. Slow enough that
     you never catch it moving and only notice the picture is not frozen —
     anything faster on a photograph this quiet reads as a screensaver.

     It lives on the <img>, NOT on .hero-frames: that element owns the opening's
     scale, and two animations fighting over one transform means the last one
     declared silently wins. Separate elements compose instead.

     Starts once the opening has finished, so the two never overlap. Transform
     only, so it is composited — no layout, no repaint, per frame.

     A multi-frame hero sets its own zoom inline (brtHeroZoom, for the
     crossfade); inline styles outrank this rule, so that case is untouched. */
  .hero-frame img {
    animation: heroDrift 20s ease-in-out 3.2s infinite alternate;
  }
  @keyframes heroDrift {
    from { transform: scale(1); }
    to   { transform: scale(1.055); }
  }

  /* A phone screen is far narrower than even the vertical crop, so `cover` still
     trims the sides. Dead-centre cut the subject's head off at the left edge;
     biasing the crop left keeps the head whole and spends the trim on the empty
     right instead. Same media query as the <source> above, so it applies exactly
     when that file is the one being shown. */
  @media (orientation: portrait) {
    .hero-frame img { object-position: 35% center; }
  }


  /* ------------------------------- ink -------------------------------- */
  .hero { --hero-ink: #fff; --hero-ink-soft: rgb(255 255 255 / 0.72); }
  .hero[data-ink='dark'] {
    --hero-ink: var(--color-text);
    --hero-ink-soft: var(--color-muted);
  }

  /* Keeps the marks legible without flattening the photograph. Weighted to the
     two bands that actually carry something — the bar at the top and the cue at
     the bottom — and left open through the middle so the room reads.

     The scrim runs the SAME direction as the ink: over a dark photograph it
     deepens the shadows so white reads; over a high-key one it lifts the frame
     so page ink reads. A dark scrim under dark ink would bury it. */
  .hero-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.42) 0%,
      rgb(0 0 0 / 0.10) 22%,
      rgb(0 0 0 / 0.04) 42%,
      rgb(0 0 0 / 0.40) 68%,
      rgb(0 0 0 / 0.66) 86%,
      rgb(0 0 0 / 0.74) 100%
    );
  }
  .hero[data-ink='dark'] .hero-scrim {
    background: linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.34) 0%,
      rgb(255 255 255 / 0.10) 18%,
      rgb(255 255 255 / 0) 38%,
      rgb(255 255 255 / 0) 62%,
      rgb(255 255 255 / 0.30) 88%,
      rgb(255 255 255 / 0.46) 100%
    );
  }

  /* --------------------- the mark: it forms, then it stays ----------------
     The choreography is BrandMark's own `draw` — the same gesture the bar plays
     on every page change — slowed down, because this copy is many times larger.
     It runs ONCE and stops. No loop: a mark that keeps rebuilding itself pulls
     the eye back every few seconds, which is the opposite of what this page is
     for. `both` fill-mode is what makes it stay drawn afterwards.

     Nothing here keys off the veil any more — on a page with a hero there IS no
     veil. That coupling also had a latent bug: `intro-ran` survives a view
     transition, so arriving at the homepage FROM an inner page inherited a
     3.3-second wait with no veil on screen to justify it. */
  .hero-mark { --draw-speed: 1.6; --draw-delay: 0.35s; }

  /* The cue arrives once the photograph is there — it points into a picture. */
  .hero-cue { animation: heroIn 1.9s var(--reveal-ease) 2.6s both; }
  @keyframes heroIn {
    from { opacity: 0; filter: blur(7px); transform: translateY(14px); }
    to   { opacity: 1; filter: none;      transform: none; }
  }

  /* ------------------- "there is more below this" ----------------------
     A full screen of photograph with a still mark on it reads as a picture,
     not as the top of a page — nothing says the page continues. So the cue
     moves: a bright segment falls down a faint track, and the chevron dips as
     it lands. Both loop on the same 2.6s clock, with a pause between drops so
     it stays a hint rather than a blinking arrow.

     The motion goes on the CHILDREN. The cue itself already carries the
     entrance animation, and a second animation on the same element would just
     replace it — the mistake the photograph's drift had to avoid too. */
  .hero-cue-line::after,
  .hero-cue svg { animation-delay: 3.4s; }        /* after the cue has arrived */

  .hero-cue-line::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 45%;
    background: linear-gradient(to bottom, transparent, currentColor);
    animation: cueDrop 2.6s cubic-bezier(0.5, 0, 0.5, 1) infinite;
  }
  /* -100% is fully above the track, 222% (of its own 45% height) fully below. */
  @keyframes cueDrop {
    0%        { transform: translateY(-100%); opacity: 0; }
    18%       { opacity: 1; }
    62%       { transform: translateY(222%);  opacity: 0; }
    100%      { transform: translateY(222%);  opacity: 0; }
  }
  .hero-cue svg { animation: cueBob 2.6s ease-in-out infinite; }
  @keyframes cueBob {
    0%, 46%, 100% { transform: none; }
    64%           { transform: translateY(3px); }
  }

  /* ------------------------------ content ----------------------------- */
  /* --mark-y is the logotype's CENTRE line, top-down. Default sits it low, above
     the cue; a photograph with a busy foreground overrides it. */
  .hero-content {
    position: absolute;
    inset-inline: 0;
    bottom: clamp(6.5rem, 12vh, 9.5rem);   /* clears the scroll cue */
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--stack-sm);
    padding-inline: var(--space-container);
    color: var(--hero-ink);
  }
  /* markY is a wish, not a command: the mark never rides up under the bar. The
     floor is computed from the SAME --nav-bar-h the bar itself uses, plus half
     the mark's own height, so it holds at any viewport without a second number
     to keep in sync. */
  .hero--placed { --mark-y-used: var(--mark-y); }
  /* Same media query as the <source>, so the position changes exactly when the
     photograph does. A separate variable, not a self-referencing fallback:
     `--mark-y: var(--mark-y-portrait, var(--mark-y))` is a cycle and the whole
     declaration is thrown away. */
  @media (orientation: portrait) {
    .hero--placed { --mark-y-used: var(--mark-y-portrait, var(--mark-y)); }
  }
  .hero--placed .hero-content {
    top: max(var(--mark-y-used), calc(var(--nav-bar-h) + 1.75rem + var(--mark-h) / 2));
    bottom: auto;
    transform: translateY(-50%);
  }
  .hero-h1 { margin: 0; }
  /* Sized off the viewport, but capped: the mark is the quiet centre of the
     frame, not a banner. The photograph still carries the scale.
     The height is DERIVED from the logo's own viewBox ratio (267.9 / 181.3), so
     the placement floor above can reason about it before layout happens. */
  .hero {
    --mark-w: clamp(11rem, 26vw, 19rem);
    --mark-h: calc(var(--mark-w) / 1.478);
  }
  .hero-mark {
    display: block;
    width: var(--mark-w);
    max-width: 72vw;
  }

  /* A letterboxed window — a phone held sideways, or a short desktop window —
     crops a landscape photograph straight through its middle, which is exactly
     where the subject is. Bias the crop upward and shrink the mark, so the two
     stay in the empty part of the frame instead of colliding in it.

     Gated on the SHAPE of the window, not its width: a tall phone at 360×640 is
     short too, but its crop is horizontal and needs none of this.

     Must come AFTER the .hero rule above — same specificity, so source order
     decides, and declaring it earlier silently loses. */
  @media (min-aspect-ratio: 3 / 2) and (max-height: 46rem) {
    .hero-frame img { object-position: center 20%; }
    .hero { --mark-w: clamp(7.5rem, 14vw, 10.5rem); }
    /* Biasing the crop upward pushes the darkest part of the photograph down
       into the strip the cue sits in, so that end of the scrim has to work
       harder here than it does in a full-height frame. */
    .hero[data-ink='dark'] .hero-scrim {
      background: linear-gradient(
        to bottom,
        rgb(255 255 255 / 0.30) 0%,
        rgb(255 255 255 / 0.06) 20%,
        rgb(255 255 255 / 0) 45%,
        rgb(255 255 255 / 0.42) 82%,
        rgb(255 255 255 / 0.72) 100%
      );
    }
  }

  /* ------------------------------ scroll cue --------------------------- */
  .hero-cue {
    position: absolute;
    inset-inline: 0;
    bottom: max(1.75rem, env(safe-area-inset-bottom));
    margin-inline: auto;
    width: 2.75rem;
    min-height: 2.75rem;                    /* ≥44px tap target */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
    color: var(--hero-ink);              /* full ink — it has to be noticed */
    text-decoration: none;
  }
  .hero-cue-line {
    position: relative;
    display: block;
    width: 1px;                          /* px — hairline */
    height: 3rem;
    overflow: hidden;
    background: color-mix(in srgb, currentColor 22%, transparent);
  }
  @media (hover: hover) {
    /* Colour only. A transform here would never apply: the entrance animation
       ends on `transform: none` with `both` fill, and a filled animation beats
       a plain declaration in the cascade — the old hover nudge never once ran. */
    .hero-cue { transition: color var(--transition-base); }
    .hero-cue:hover { color: var(--color-accent); }
  }

  /* --------------------------- reduced motion --------------------------
     Inline animations win the cascade, so these need !important: the hero
     collapses to a single still frame. */
  @media (prefers-reduced-motion: reduce) {
    .hero-frame,
    .hero-frame img { animation: none !important; }
    .hero-frame { opacity: 0 !important; }
    .hero-frame:first-child { opacity: 1 !important; }
    .hero-frame img { transform: none !important; }
    /* The photograph is simply there. BrandMark drops its own draw already. */
    .hero-frames,
    .hero-scrim,
    .hero-cue { animation: none !important; opacity: 1; filter: none; transform: none; }
    /* The cue stops moving, so its track has to read on its own. */
    .hero-cue svg { animation: none !important; }
    .hero-cue-line::after { animation: none !important; opacity: 1; transform: translateY(122%); }
  }
</style>
