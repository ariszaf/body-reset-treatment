---
/**
 * StepsRail — the same three steps, laid out sideways.
 *
 * Desktop (≥64rem): all three at once, three across, nothing to operate.
 * Below that:       a strip you swipe, the next card deliberately part-way into
 *                   frame, with dots underneath saying how many there are.
 *
 * WHY EMBLA AND NOT A CSS SCROLLER. This was a native `overflow-x: auto` rail
 * with scroll-snap, and it broke scrolling on a phone in a way that took three
 * attempts to pin down. Measured with real touch events on an iPhone profile:
 *
 *   sideways component of the swipe   page moved   rail moved
 *   0–40px                            360–422px    0
 *   60px                              0            0
 *   90px                              0            0
 *
 * `overflow-x: auto` with `overflow-y: visible` computes to a scroll container
 * on BOTH axes. Past roughly 60px of sideways travel the browser awarded the
 * gesture to the rail, the rest of the movement was vertical, and neither axis
 * advanced. Embla never creates a scroll container — the viewport is
 * `overflow: hidden` and the container is transformed — and it decides the axis
 * itself, handing vertical drags straight back to the page.
 *
 * Three things this still has to get right that a plain grid does not:
 *
 * 1. REVEAL. The site's scroll-reveal engine hides an element until it enters
 *    the viewport. A card parked off to the right never enters it, so it would
 *    sit at opacity 0 forever and the swipe would land on nothing. Per-card
 *    reveal is switched off at strip widths and only staggers on desktop.
 *
 * 2. NO-JAVASCRIPT. The base layout is a vertical stack — all three cards
 *    readable, nothing hidden, no scroller. `is-embla`, added by the script,
 *    is what turns it into a strip. The reference does the opposite and leaves
 *    two thirds of its content unreachable when the library fails to load.
 *
 * 3. The dots are real buttons (Embla scrolls to the slide), and they only
 *    exist once `is-embla` is on — a control that cannot work is not shown.
 *
 * Props: eyebrow · title · id (anchor) · steps
 */
import Container from '@components/Container.astro';
import BrandIcon from '@components/BrandIcon.astro';
import type { IconName } from '@lib/icons';

interface Props {
  eyebrow?: string;
  title?: string;
  id?: string;
  steps: { icon: IconName; title: string; text: string }[];
}
const { eyebrow, title, id, steps } = Astro.props;
---

<section class="rail" id={id}>
  <Container>
    {/* h2 for the same reason as the treatments section: the cards below are
        h3 and this is their parent. */}
    {eyebrow && <h2 class="text-eyebrow rail-eyebrow reveal reveal-up">{eyebrow}</h2>}
    {title && <h2 class="text-section-title rail-title reveal reveal-up">{title}</h2>}

    <div class="rail-embla" data-embla>
      <div class="embla">
        <ol class="embla__container reveal-stagger">
          {steps.map((s) => (
            <li class="embla__slide rail-card reveal reveal-up">
              <BrandIcon name={s.icon} class="rail-icon" />
              <h3 class="text-card-title rail-card-title">{s.title}</h3>
              <p class="text-card-body rail-text">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>

      {/* Dots say HOW MANY. They do not say "this moves sideways", and on a
          phone that is the thing nobody works out from a still screen — the
          peeking next card is a hint only once you already suspect it. The
          chevron drifts right until the strip is first touched, then stops for
          good (data-moved, set by the carousel script). Decorative: the dots
          carry the state a screen reader needs. */}
      <div class="rail-controls">
        <div class="rail-dots">
          {steps.map((s, i) => (
            <button class="embla__dot" type="button" data-on={i === 0 ? '' : undefined}
                    aria-current={i === 0 ? 'true' : 'false'} aria-label={s.title} />
          ))}
        </div>
        <span class="rail-hint" aria-hidden="true">
          <svg width="20" height="9" viewBox="0 0 20 9" fill="none">
            <path d="M1 4.5h16M13 1l4 3.5-4 3.5" stroke="currentColor" stroke-width="1.5"
                  stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </div>
    </div>
  </Container>
</section>

<style>
  .rail { padding-block: var(--space-section); }
  .rail-eyebrow { margin: 0; }
  .rail-title { margin-block-start: var(--stack-md); }

  /* ---- base: a plain vertical stack. This is what renders without JS. ---- */
  .embla__container {
    list-style: none;
    margin: var(--stack-xl) 0 0;
    padding: 0;
    display: grid;
    gap: var(--stack-lg);
  }
  .rail-card {
    padding-block-start: var(--stack-md);
    border-top: 1px solid var(--color-border);
  }
  .rail-card :global(.rail-icon) {
    display: block;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text);
  }
  .rail-card-title { margin-block-start: var(--stack-md); }
  .rail-text { margin-block-start: var(--stack-sm); color: var(--color-muted); }

  /* Nothing to indicate until there is something to swipe. */
  .rail-dots,
  .rail-hint { display: none; }

  .rail-hint {
    color: color-mix(in srgb, var(--color-text) 45%, var(--color-bg));
    line-height: 0;
    animation: railHint 2.4s var(--reveal-ease) infinite;
  }
  /* Stops for good once the strip has been touched. */
  .is-embla[data-moved] .rail-hint { animation: none; opacity: 0; transition: opacity var(--transition-base); }

  @keyframes railHint {
    0%, 55%, 100% { transform: none; }
    72%           { transform: translateX(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .rail-hint { animation: none; }
  }

  /* ---------------------- large screens: all three ---------------------- */
  @media (min-width: 64rem) {
    .embla__container { grid-template-columns: repeat(3, 1fr); gap: var(--stack-lg); }
  }

  /* ------------------- narrower, WITH the script running ----------------
     Everything here is behind `.is-embla`, which the carousel script adds once
     it has taken over. Until then the stack above is what the visitor gets. */
  @media (max-width: 63.99rem) {
    /* Out of the text column and up to both screen edges, so the peeking card
       is cut by the screen and not by the container's padding. */
    .is-embla .embla {
      overflow: hidden;                   /* NOT a scroll container */
      margin-inline: calc(-1 * var(--space-container));
      padding-inline: var(--space-container);
    }
    .is-embla .embla__container {
      display: flex;
      gap: var(--stack-md);
      align-items: stretch;
    }
    .is-embla .embla__slide {
      flex: 0 0 80%;                      /* the next card is clearly started */
      min-width: 0;
    }

    /* See note 1 in the header: a card parked off-screen never satisfies the
       IntersectionObserver, so without this it would never be revealed. */
    .is-embla .embla__container :global(.reveal) {
      opacity: 1;
      transform: none;
      filter: none;
    }

    .is-embla .rail-dots { display: flex; gap: 0.5rem; }
    .is-embla .rail-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--stack-md);
      margin-block-start: var(--stack-lg);
    }
    .is-embla .rail-hint { display: block; }
  }

  .embla__dot {
    /* A 6px mark inside a 44px target — the dot is the affordance, the padding
       is for the finger. */
    inline-size: 2.75rem;
    block-size: 2.75rem;
    margin: -0.9rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .embla__dot::before {
    content: '';
    inline-size: 0.4rem;
    block-size: 0.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-text) 22%, transparent);
    transition: background var(--transition-base), transform var(--transition-base);
  }
  .embla__dot[data-on]::before {
    background: var(--color-accent);
    transform: scale(1.35);
  }

  @media (prefers-reduced-motion: reduce) {
    .embla__dot::before { transition: none; }
  }
</style>

<script>
  import '../../scripts/carousel';
</script>
