---
/**
 * PinnedSteps — the panel holds still while the content changes under the scroll.
 *
 * A tall track (one viewport per step) with a `position: sticky` stage inside it.
 * The page keeps scrolling completely normally — nothing is hijacked, the
 * scrollbar never lies, and a flick of the wheel is never swallowed. What the
 * visitor sees is the stage pinned in place while the step inside it swaps.
 *
 * Progress is computed from the track's own position rather than from step
 * markers or IntersectionObserver: one rAF-throttled read of getBoundingClientRect
 * gives an exact 0→1 fraction, so the swap point is deterministic instead of
 * depending on threshold tuning.
 *
 * Degradation is the default state, not an afterthought — the markup renders as
 * a plain stacked list, and the pinning only switches on when JS adds
 * `is-pinned`. No JS, or reduced motion: all steps are simply readable in order.
 *
 * Props:
 *   eyebrow  small label above the stage
 *   title    section heading
 *   steps    { icon?, title, text, image? }[]
 */
import Container from '@components/Container.astro';
import BrandIcon from '@components/BrandIcon.astro';
import type { IconName } from '@lib/icons';
import type { ImageEntry } from '@content/images';

interface Props {
  eyebrow?: string;
  title?: string;
  /** anchor target — the hero's scroll cue points at whatever comes first */
  id?: string;
  /**
   * `image` is optional: with one, a step becomes a showcase card — the name in
   * the brand's accent, a line, a photograph. Without it, the plain step it
   * always was. One mechanism, two uses — the pin/progress logic is subtle
   * enough that a second copy of it would drift within a month.
   */
  steps: {
    icon?: IconName;
    title: string;
    text: string;
    image?: ImageEntry;
    /** where "Αναλυτικά" goes — omit and no link is rendered */
    href?: string;
  }[];
}
const { eyebrow, title, id, steps } = Astro.props;
const hasMedia = steps.some((s) => s.image);
---

<section class="pinned" id={id} style={`--steps:${steps.length}`}>
  <div class="pinned-track">
    <div class="pinned-stage">
      <Container>
        <div class="pinned-inner">
          {/* h2, not a paragraph. The treatment names inside are h3, so with a
              styled <p> here the document jumped h1 → h3 and a screen reader
              announced six level-3 headings with no parent. It looks identical;
              only the outline changes. */}
          {eyebrow && <h2 class="text-eyebrow pinned-eyebrow">{eyebrow}</h2>}
          {title && <h2 class="text-section-title pinned-title">{title}</h2>}

          <ol class="pinned-steps" data-media={hasMedia ? '' : undefined}>
            {steps.map((s, i) => (
              <li class="pinned-step" data-step={i} aria-hidden={i === 0 ? undefined : 'true'}>
                <div class="pinned-step-copy">
                  {s.icon && <BrandIcon name={s.icon} class="pinned-icon" />}
                  <h3 class="text-card-title pinned-step-title">{s.title}</h3>
                  <p class="pinned-step-text">{s.text}</p>
                </div>

                {/* A sibling of the copy, not a child of it. On a phone it is
                    positioned down by the arrows, and the copy carries
                    `position: relative` for its own scrim — which would have
                    made it the link's containing block and pinned the link to
                    the top of the screen instead.
                    Only the visible step is reachable: the script marks the
                    others `inert`, so there are never six stacked links under
                    one finger or six stops on the tab key. */}
                {s.href && (
                  <a class="pinned-more" href={s.href}>
                    Περισσότερα για τη θεραπεία<span aria-hidden="true"> →</span>
                  </a>
                )}

                {/* The photograph lives INSIDE the step, not in a column of its
                    own. That way it swaps with the step for free in pinned mode,
                    and in the plain stacked fallback each step still keeps its
                    own picture instead of all of them sharing one slot. */}
                {s.image && (
                  <figure class="pinned-step-media">
                    <picture>
                      {/* A DIFFERENT CUT, not a bigger file. From 64rem up the
                          picture fills half the window, and the 2:3 frame would
                          lose a third of its height to `cover`, taken from the
                          middle, which is where the heads are. The wide frame
                          has that third removed on purpose — see
                          make-wide-crops.py.

                          The ASPECT test is not decoration. Which cut fits
                          depends on the window's shape, because the box is half
                          its width by all of its height: on a 4:3 laptop that
                          box is 2:3 exactly and the original arrives whole,
                          while the wide cut would lose a quarter of its sides.
                          Measured: 25% at 1024×768, 0% with this test in place.
                          3/2 is the crossover — above it the box is square
                          enough that the wide cut is the one that survives. */}
                      {s.image.wide && (
                        <source
                          media="(min-width: 64rem) and (min-aspect-ratio: 3/2)"
                          srcset={s.image.wide.src}
                          width={s.image.wide.width}
                          height={s.image.wide.height}
                        />
                      )}
                      <img
                        src={s.image.src}
                        alt={s.image.alt}
                        width={s.image.width}
                        height={s.image.height}
                        loading={i === 0 ? 'eager' : 'lazy'}
                        decoding="async"
                        style={s.image.focus ? `--img-focus:${s.image.focus}` : undefined}
                      />
                    </picture>
                  </figure>
                )}
              </li>
            ))}
          </ol>

          <div class="pinned-foot">
            {/* A COUNT, not a row of rules. Six hairlines across a 360px screen
                came out at 12px each and stopped reading as progress at all,
                which is why the phone got a count first; on a desktop the rules
                worked but said less — "one of six" is a position, six marks are
                a decoration you have to decode. One indicator now, everywhere.
                Decorative: the step itself is already announced, so a screen
                reader gains nothing from it. */}
            <p class="pinned-count" aria-hidden="true"><span data-count>1</span>/{steps.length}</p>

            {/* Real buttons, not decoration. The section only advances when you
                scroll, which is not obvious from a still frame — so as well as
                SAYING "there is more", these do it: each one scrolls to the next
                step's position. Anyone on a keyboard gets the same. Hidden
                without JS, where there is nothing to page through. */}
            <div class="pinned-nav">
              <button class="pinned-arrow" type="button" data-dir="-1" aria-label="Προηγούμενη θεραπεία">
                <svg width="13" height="9" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                  <path d="M1 7L6 2L11 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
              <button class="pinned-arrow" type="button" data-dir="1" aria-label="Επόμενη θεραπεία">
                <svg width="13" height="9" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                  <path d="M1 1L6 6L11 1" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </Container>
    </div>
  </div>
</section>

<style>
  /* ---------------- default: a plain stacked list (no JS / reduced motion) --- */
  .pinned { padding-block: var(--space-section); }
  .pinned-steps { list-style: none; margin: var(--stack-xl) 0 0; padding: 0; display: grid; gap: var(--stack-xl); }
  .pinned-step { padding-block-start: var(--stack-md); border-top: 1px solid var(--color-border); }
  .pinned-step-title { margin-block-start: var(--stack-md); }
  .pinned-step-text {
    margin-block-start: var(--stack-sm);
    font-size: var(--text-lead);
    line-height: 1.55;
    color: var(--color-muted);
    max-width: 34rem;
  }
  .pinned-eyebrow { margin: 0; }
  .pinned-title { margin-block-start: var(--stack-md); }
  /* Both only exist in pinned mode — the stacked fallback is already a list you
     read top to bottom, with nothing to page through. */
  .pinned-nav,
  .pinned-count { display: none; }

  /* ------------------------- showcase (with a photo) ------------------------ */
  /* The accent used to sit on a small category label above the name. The label
     is gone; the colour moved onto the name itself, which is now the only warm
     thing on the page and reads as the mark of a treatment. */
  .pinned-steps[data-media] .pinned-step-title {
    color: var(--color-accent);
    margin-block-start: 0;
  }
  /* Quiet on purpose: this is a way out for someone who wants more, not a
     call to action competing with the appointment. */
  /* Smaller in every way that is available. 17px is the project's hard floor and
     it is not crossed — so the weight comes off, the uppercase and the 0.22em
     tracking go, and the rule under it thins. It reads as an aside rather than
     as a second call to action. */
  .pinned-more {
    display: inline-block;
    margin-block-start: var(--stack-md);
    font-size: var(--text-label);      /* 17px floor — never smaller */
    font-weight: 400;
    letter-spacing: 0.01em;
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-bg));
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    /* The visual weight is light; the TARGET is not. Padding alone left it at
       ~34px, which the launch gate caught. min-height plus a negative margin
       gives a finger 44px without moving anything on screen. */
    padding-block: 0.5em 0.15em;
    min-block-size: 2.75rem;
    display: inline-flex;
    align-items: flex-end;
    margin-block-end: -0.55rem;
  }
  @media (hover: hover) {
    .pinned-more { transition: color var(--transition-base), border-color var(--transition-base); }
    .pinned-more:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  }

  /* A short line reads better next to a picture than a wide one. */
  .pinned-steps[data-media] .pinned-step-text {
    font-size: var(--text-card-body);
    max-width: 32ch;
  }
  /* --------------------------- the photographs --------------------------
     They are all 1200×1800 — a 2:3 portrait. Every box that holds one uses
     THAT ratio, so `object-fit: cover` has nothing left to cut and the frame
     arrives whole.

     This is what was wrong on a phone: the box was 4:3, a landscape shape, and
     covering it with a portrait photograph threw away two thirds of the height
     — the therapist's head and most of the table.

     Where vertical space is tight the box is sized by HEIGHT and its width
     follows the ratio. That shrinks the picture instead of cropping it, which
     is the whole point. --img-ratio keeps the number in one place: change the
     shoot's format and only this line moves. */
  .pinned-steps[data-media] { --img-ratio: 2 / 3; }
  .pinned-step-media {
    margin: var(--stack-lg) 0 0;
    width: 100%;
    aspect-ratio: var(--img-ratio);
    overflow: hidden;
  }
  /* The <picture> is a pass-through — the <img> stays the direct child of the
     figure, so every rule below still lands on it whichever <source> won. */
  .pinned-step-media picture { display: contents; }
  .pinned-step-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-focus, 50% 50%);
  }

  @media (min-width: 64rem) {
    /* Copy on the left, picture on the right — but only for steps that have one,
       so the plain «how it works» stage is untouched. */
    .pinned-steps[data-media] .pinned-step {
      display: grid;
      /* The picture's column has to be wide enough for its own ratio at the
         height below, or `max-width: 100%` squeezes the box narrower than 2:3
         and `cover` starts cropping again — which is exactly what making the
         photograph bigger caused, and only the probe saw it. */
      grid-template-columns: 1fr 0.95fr;
      gap: 0 var(--stack-xl);
      align-items: center;
    }
    /* THE PICTURE IS THE RIGHT HALF OF THE WINDOW.

       It was a whole 2:3 frame at full height, which on a 1080px-tall screen is
       720px wide — 38% of the display — and everything to its right was paper.
       It read as neither a picture nor a side; the client's word was that it
       "does not sit in the space".

       Half the window, flush to three edges, is the shape that reads. The cost
       is a crop, and the crop is NOT left to `cover`: from 64rem up a separate,
       already-wider cut of each frame is served (see the <source> above), taken
       off the top or the bottom by hand depending on where the therapist's head
       is. What `cover` is left to do here is at most 11%.

       The cap is what keeps that promise. On a short wide window half the width
       is a box wider than it is tall, and covering it would eat the height it
       was given the wide cut to protect; capping the width at the stage's own
       height holds the box at 1:1 or narrower. */
    .pinned-steps[data-media] .pinned-step-media {
      position: absolute;
      inset-block: 0;
      inset-inline-end: 0;              /* against the WINDOW — never a white strip */
      inline-size: min(50%, 100svh);
      block-size: 100%;
      margin: 0;
      aspect-ratio: auto;               /* the box no longer follows the frame */
    }
    /* Heads are at the top of every frame in this shoot and the bottom is table
       linen, so what little the box still has to give up comes off the bottom. */
    .pinned-steps[data-media] .pinned-step-media img {
      object-position: var(--img-focus, 50% 38%);
    }

    /* The words keep the left half. The width is a constant, and it falls out
       of the arithmetic rather than being chosen: the copy runs from the
       container's inner left edge to half the window, and the halves cancel —
       what is left is container/2 − gap − gutter = 416px, on every screen from
       1024 up. No vw, so no scrollbar to get wrong. */
    .pinned-inner:has(.pinned-steps[data-media]) .pinned-eyebrow,
    .pinned-inner:has(.pinned-steps[data-media]) .pinned-title,
    .pinned-inner:has(.pinned-steps[data-media]) .pinned-step,
    .pinned-inner:has(.pinned-steps[data-media]) .pinned-foot {
      max-inline-size: calc(
        var(--container-max) / 2 - var(--stack-xl) - var(--space-container)
      );
    }
    .pinned-steps[data-media] .pinned-step {
      grid-template-columns: minmax(0, 1fr);
      align-content: center;
    }
    .pinned-steps[data-media] .pinned-step-copy { grid-area: 1 / 1 / 2 / 2; align-self: end; }
    .pinned-steps[data-media] .pinned-more {
      grid-area: 2 / 1 / 3 / 2;
      align-self: start;
      justify-self: start;
    }
    /* On a wide screen the label sits BESIDE the bar's logotype, not under it,
       so the stage does not need to clear the bar's full height the way a phone
       does. The picture spans the whole stage, padding included. */
    :global(html.js-pinned) .pinned-stage { padding-block-start: var(--stack-lg); }
  }

  /* --------------------------- pinned mode (JS on) -------------------------- */
  :global(html.js-pinned) .pinned { padding-block: 0; }
  :global(html.js-pinned) .pinned-track {
    /* One viewport of scroll buys one step.

       svh, NOT dvh. On a phone `dvh` changes as the address bar hides and
       shows, so mid-scroll this track and the stage inside it were being
       remeasured — the pin appeared to stick, then jump, exactly where the
       browser chrome animates. `svh` is the SMALL viewport: it does not move,
       so the geometry the progress maths reads stays still. The strip of extra
       height while the bar is hidden is covered by the stage, which is sized in
       `lvh` for exactly that reason. */
    height: calc(var(--steps) * 100svh);
    position: relative;
  }
  :global(html.js-pinned) .pinned-stage {
    position: sticky;
    top: 0;
    /* lvh, NOT svh — and the track above stays svh on purpose.
       The two units answer different questions. The TRACK asks "how much scroll
       is a step worth", and that must not move while the address bar animates,
       so it is svh, the small viewport. The STAGE asks "how much screen do I
       have to cover", and the answer is the LARGE viewport: the moment the bar
       hides, the screen grows and a stage sized to the small viewport leaves a
       strip of bare page along the bottom edge. On a phone, in a section whose
       whole point is a full-screen photograph, that strip is the first thing
       anyone sees. The content is kept inside the small viewport separately
       (see the phone block), so nothing is pushed under the fold when the bar
       comes back. Desktop is unaffected: no dynamic chrome, lvh == svh. */
    height: 100lvh;
    display: grid;
    /* SAFE centre. Plain `center` centres content that is taller than its box by
       overflowing it EQUALLY — which pushed the eyebrow up underneath the fixed
       bar on short screens. `safe` falls back to start the moment it would
       overflow, so the top edge is never sacrificed. */
    align-content: safe center;
    /* minmax(0, 1fr), not the implicit `auto`. A grid column sized `auto` refuses
       to go below its content's min-content width, so on a 360px phone the stage
       was laying out 387px wide and everything inside it — including the corner
       the sticky call button lives in — was shifted 27px off. `overflow: hidden`
       hid the symptom perfectly: no scrollbar, no clue, just misplaced boxes. */
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    /* The bar is fixed and stays over this section the whole way through. On a
       phone its logotype and the stage's eyebrow both start at the container
       gutter, so without this they print on top of each other. Same
       --nav-bar-h the bar itself is built from. */
    padding-block-start: var(--nav-bar-h);
  }

  :global(html.js-pinned) .pinned-steps {
    margin-block-start: var(--stack-lg);
    display: grid;
    gap: 0;
  }
  /* Pinned, one column: the stage is exactly one screen and the picture has to
     leave room for the label, the title, the line and the progress rules. The
     stage clips its overflow, so anything taller would simply be cut off.

     Height first, width second — the picture gets smaller as the screen gets
     shorter, and stays whole the entire way down. */
  /* All steps stack in the SAME grid cell, so the stage never changes height and
     the pin never jumps as the text length varies. */
  :global(html.js-pinned) .pinned-step {
    grid-area: 1 / 1;
    border-top: 0;
    padding-block-start: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.55s var(--reveal-ease),
      visibility 0s linear 0.55s;
  }
  :global(html.js-pinned) .pinned-step.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.55s var(--reveal-ease);
  }
  /* The slide lives on the COPY, not on the step.
     A transform makes an element the containing block for anything absolutely
     positioned inside it — so while it sat on the step, the phone's full-bleed
     photograph was trapped inside the text's own little box (358×149 instead of
     the whole screen). Moving it one level down keeps the motion and frees the
     picture. The photograph cross-fades rather than slides, which is what a
     full-screen image should do anyway. */
  :global(html.js-pinned) .pinned-step-copy {
    transform: translateY(1.25rem);
    transition: transform 0.55s var(--reveal-ease);
  }
  :global(html.js-pinned) .pinned-step.is-active .pinned-step-copy { transform: none; }

  /* ------------------------------ progress ---------------------------------- */
  :global(html.js-pinned) .pinned-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--stack-md);
    margin-block-start: var(--stack-xl);
  }
  /* The count. Same type as a label — the 17px floor holds here as everywhere
     — with tabular figures so the slash does not shift as 1 becomes 2, and the
     current number in the accent so the eye lands on the position rather than
     on the total. */
  :global(html.js-pinned) .pinned-count {
    display: block;
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-label);          /* 17px floor — never smaller */
    font-weight: 400;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;    /* the slash must not shift on 1→2 */
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-bg));
  }
  :global(html.js-pinned) .pinned-count [data-count] { color: var(--color-accent); }

  /* ------------------------------- the arrows -------------------------------
     Deliberately faint: they are for the visitor who has not realised the
     section moves, not a control anyone else should notice. They warm on hover
     and go quiet when there is nothing in that direction. */
  :global(html.js-pinned) .pinned-nav { display: flex; flex-direction: column; }
  .pinned-arrow {
    /* 44×44 — a finger needs BOTH dimensions. 44×36 looked fine on screen and
       the launch gate caught it as a tap target that is too small. */
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    /* An OPAQUE mix toward the page colour, not ink faded with `transparent`.
       A translucent glyph takes its final colour from whatever is behind it, so
       over a photograph it is darker or lighter frame by frame and there is no
       single value to hold to a contrast standard. This mixes to a real colour
       that is the same everywhere, and the halo below sits under it. */
    color: color-mix(in srgb, var(--color-text) 90%, var(--color-bg));
  }
  .pinned-arrow[disabled] { opacity: 0.25; cursor: default; }
  @media (hover: hover) {
    .pinned-arrow { transition: color var(--transition-base); }
    .pinned-arrow:not([disabled]):hover { color: var(--color-accent); }
  }

  /* The hint. While the visitor is still on the first step, the down arrow
     breathes downward — the one gesture that says "this keeps going". JS drops
     `data-hint` the moment the step changes, so it stops as soon as it has been
     understood, and it never plays for someone already scrolling. */
  .pinned[data-hint] .pinned-arrow[data-dir='1'] {
    color: var(--color-accent);
    animation: pinHint 2.2s ease-in-out infinite;
  }
  @keyframes pinHint {
    0%, 55%, 100% { transform: none; }
    72%           { transform: translateY(4px); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* Never pin: the stacked list is the whole experience. */
    :global(html.js-pinned) .pinned-track { height: auto; }
    :global(html.js-pinned) .pinned-stage { position: static; height: auto; overflow: visible; }
    :global(html.js-pinned) .pinned-steps { gap: var(--stack-xl); }
    :global(html.js-pinned) .pinned-step {
      grid-area: auto;
      opacity: 1;
      visibility: visible;
      transform: none;
      transition: none;
      border-top: 1px solid var(--color-border);
      padding-block-start: var(--stack-md);
    }
  }
  /* ------------------- pinned, one column: the phone --------------------
     LAST in the file on purpose. Every rule here overrides a base rule of the
     same specificity, and source order is what decides — an earlier attempt sat
     above `.pinned-nav { flex-direction: column }` and silently lost.

     On a phone the photograph takes the whole screen and the words sit on top
     of it. That works because of how `cover` chooses its scale: the frame is
     2:3 and the screen is far narrower, so it scales to FILL THE HEIGHT and
     trims the sides. The empty wall at the top of every frame therefore always
     survives — which is exactly the band the label and the name land in. */
  @media (max-width: 63.99rem) {
    /* Content to the top, inside the SMALL viewport. The stage is `lvh` so the
       photograph covers the screen even with the address bar hidden; the words
       and the controls live in the first `svh` of it, which is the band that is
       visible in both states. Without this they would stretch to the bottom of
       the large viewport and the arrows would sit under the bar. */
    :global(html.js-pinned) .pinned-stage { align-content: start; }
    :global(html.js-pinned) .pinned-stage > :global(.container) {
      display: flex;
      /* Minus the bar: the stage already reserves that much padding at the top
         for the fixed logotype, so a plain 100svh here would push the arrows
         exactly one bar-height below the fold. Measured at −80px before this. */
      block-size: calc(100svh - var(--nav-bar-h));
    }
    :global(html.js-pinned) .pinned-inner {
      display: flex;
      flex-direction: column;
      width: 100%;
      /* Was --stack-md (24px). The arrows and the count are the last thing on
         the screen and they were sitting a whole gutter above the edge, which
         both wasted the band and crowded the link above them. */
      padding-block-end: var(--stack-sm);
    }
    /* No description on a phone. The screen is the photograph's, and the name
       plus a way in is all that fits without eating into it. The sentence is
       not lost — it opens the treatment's own page, one tap away. */
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-text { display: none; }

    /* The link moves to the bottom, just above the rules. Absolute against the
       STAGE — the step is not positioned, so there is nothing in between — which
       means all six stack in the same spot and only the active one is visible,
       exactly like the photographs. */
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-more {
      position: absolute;
      /* The containing block is the STAGE, which is full-bleed — so the gutter
         has to be added back by hand or the link sits flush against the screen
         edge while every other line starts at the text column. */
      inset-inline-start: var(--space-container);
      /* Clear of the row below it, not just above the call button. The gap
         between this link and the arrows measured 20px, and both carry a 44px
         touch box, so the two reads were touching. One more gutter of air. */
      inset-block-end: calc(var(--stack-lg) + var(--fab-size) + var(--stack-sm));
      margin: 0;
      z-index: 1;
      /* One ring, and not a solid one. Two were still reading as lit; this is
         enough to keep the letterforms off the grain of the photograph without
         announcing itself. It stays where the label and the name go bare
         because it is the smallest type on the screen and the only one anyone
         has to be able to press. */
      text-shadow: 0 0 3px rgb(246 243 238 / 0.65);
    }
    :global(html.js-pinned) .pinned-foot {
      margin-block-start: auto;
      /* Room for the sticky call button, which is fixed in this same corner.
         Reserved here rather than by moving the button, because the button is on
         every page and this row is the only thing that ever reaches it. */
      padding-inline-end: calc(
        var(--fab-size) + var(--fab-inset) - var(--space-container) + var(--stack-md)
      );
    }
    :global(html.js-pinned) .pinned-steps { margin-block-start: var(--stack-md); }
    :global(html.js-pinned) .pinned-eyebrow { margin: 0; }
    /* Up and down side by side rather than stacked — saves height, and a pager
       reads perfectly well in a row. */
    :global(html.js-pinned) .pinned-nav { flex-direction: row; }
    /* Six desktop-width rules plus two 44px buttons come to more than a phone is
       wide, and the stage's `overflow: hidden` was quietly swallowing the arrows
       off the right edge — present in the DOM, impossible to press. */
    /* Six rules + two 44px buttons + the button's reserved corner must all fit
       across 320px. They did not: flex pushed the arrows past the reserve and
       back under the call button by a few pixels. Both the rules and the gaps
       between them now scale with the screen instead of holding a fixed size. */
    /* On a phone the count sits ON the photograph, so it takes the same tight
       halo as the rest of the type over a picture. Nowhere else needs it: on a
       desktop it is on paper and the halo is page colour on page colour. */
    :global(html.js-pinned) .pinned-count {
      text-shadow:
        0 0 12px rgb(246 243 238),
        0 0 6px rgb(246 243 238),
        0 0 3px rgb(246 243 238),
        0 0 1.5px rgb(246 243 238);
    }

    /* The photograph fills the stage. It stays INSIDE its step, so it still
       cross-fades with the step for free; only its box changes.

       The words are LIFTED above it rather than the picture pushed below with a
       negative z-index. That was the first attempt and it failed: the figure
       comes after the copy in the DOM, and `z-index: -1` resolved against a
       stacking context that left the image painting over the label — proved
       with elementFromPoint, which returned the IMG where the label is. An
       explicit z-index on the content cannot be argued with. */
    :global(html.js-pinned) .pinned-step-copy,
    :global(html.js-pinned) .pinned-foot { position: relative; z-index: 1; }
    /* The label needs to sit ABOVE the copy, not merely above the picture. The
       copy's own scrim reaches up past it, and with both on z-index 1 the copy
       comes later in the DOM and won its scrim the right to paint over the
       label. `pointer-events: none` on that scrim meant hit-testing still
       reported the label on top — the check passed while the label was being
       washed out on screen. */
    :global(html.js-pinned) .pinned-eyebrow {
      position: relative;
      z-index: 2;
      /* Ink, not accent. The gold tops out at 5.1:1 even on clean paper, and at
         17px with wide tracking there is not enough of it per glyph to carry
         over a photograph. The gold stays where it was asked for — on the
         treatment's NAME.

         Deeper than page ink, though. With no halo left to help, the plain
         #33302c fell to 4.33:1 against the lit wall of the cupping frame —
         under the 4.5 this size has to hold. This is the same ink, darker, and
         at 17px uppercase nobody will see the difference. */
      color: color-mix(in srgb, var(--color-text) 78%, #000);
    }
    /* Bold over a photograph. It is also what lets the name be judged as large
       text (≥18.66px bold → 3:1) instead of body copy, which is the honest
       reading for a 19px semibold heading. */
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-title {
      font-weight: 700;
      /* The same gold, deeper. With the halo gone the light was doing the
         separating; now the ink has to. #75644e is a mid-tone and against a
         lit wall it measured as low as 1.03:1 — the word was there and could
         not be read. Deepening it keeps the colour the client asked for and
         buys back the contrast without putting a glow behind it. */
      color: color-mix(in srgb, var(--color-accent) 62%, #000);
    }

    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-media {
      position: absolute;
      /* Anchored to the TOP and taller than the screen, so the frame is scaled
         up and its subject drops. The words and the therapist's face were
         landing on the same band — no scrim geometry can both cover the text and
         spare the face, because they were in the same place. Giving the picture
         more height moves the face down out from under the words instead.

         The cost is horizontal: a taller box crops more from the sides. --zoom
         is the dial; the probe reports the crop so it can be watched. */
      inset: 0 0 auto 0;
      z-index: 0;
      margin: 0;
      width: auto;
      aspect-ratio: auto;               /* fill the stage, not the ratio */
      max-width: none;
      height: var(--zoom, 100%);        /* LAST — an `auto` after it would win */
    }
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-media img {
      object-position: center;
    }
    /* NO rectangle behind the words on a phone.
       There used to be a gradient panel here, and even at low opacity it read as
       a lit band running the full width of the screen — the lightening stopped
       where the column stopped, not where the sentence stopped, which is what
       made it look stuck on. The halo on the glyphs is doing the work anyway,
       and it is shaped like the words. */
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-copy::before { content: none; }
    /* No scrim at the bottom. It was lightening the foot of every frame and the
       picture stopped reaching the edge of the screen; the marks carry their own
       halo (below), which is enough on its own — measured. */

    /* NO halo on the label or the treatment's name. Asked for plainly and
       twice: no lighting, no white around the letters. They are set straight
       onto the photograph.

       What makes that survivable is the shoot itself — every frame is high-key,
       a light wall and white linen, so dark ink on it is dark-on-light almost
       everywhere. The numbers are in the commit; where a frame closes in on the
       therapist's black shirt the reading is thinner than it was, and that is
       the trade being made on purpose. */
    /* Same idea for the arrows, which are strokes rather than glyphs. */
    :global(html.js-pinned) .pinned-nav {
      /* Four rings, not two. A stroke this thin carries less of its own halo
         than a letter does — the marks fell to 2.54:1 against the darkest
         frames with only the two the type uses. */
      filter:
        drop-shadow(0 0 14px rgb(246 243 238))
        drop-shadow(0 0 8px rgb(246 243 238))
        drop-shadow(0 0 4px rgb(246 243 238))
        drop-shadow(0 0 2px rgb(246 243 238));
    }

    /* Reading over a photograph: a comfortable measure, and FULL ink rather
       than the muted grey used on plain paper. */
    :global(html.js-pinned) .pinned-steps[data-media] .pinned-step-text {
      /* The full column, deliberately. A narrower measure reads better on
         paper, but here it wraps the same sentence onto three lines instead of
         two — and every extra line pushes the scrim further down the frame, on
         to the therapist's face. Wide and short keeps the picture clear. */
      max-width: none;
      color: var(--color-text);
    }
  }
</style>

<script>
  /**
   * Pinning is opt-in from JS so the no-JS render is a readable list, never a
   * stack of invisible absolutely-positioned steps.
   */
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Teardown for everything bound to `window`. The `dataset.pinBound` guard
     lives on a DOM node, and the view-transitions router replaces those — the
     window does not. Without this, every navigation back to a page with a
     pinned section left ANOTHER scroll listener alive, holding a detached
     track and calling getBoundingClientRect() on it every frame. It compounds
     for as long as the visitor keeps browsing. */
  const teardown: Array<() => void> = [];

  function bind() {
    const sections = document.querySelectorAll<HTMLElement>('.pinned');
    if (!sections.length || reduce) return;
    document.documentElement.classList.add('js-pinned');

    sections.forEach((section) => {
      if (section.dataset.pinBound) return;
      section.dataset.pinBound = '1';

      const track = section.querySelector<HTMLElement>('.pinned-track');
      const stage = section.querySelector<HTMLElement>('.pinned-stage');
      const steps = [...section.querySelectorAll<HTMLElement>('.pinned-step')];
      const arrows = [...section.querySelectorAll<HTMLButtonElement>('.pinned-arrow')];
      const count = section.querySelector<HTMLElement>('[data-count]');
      if (!track || !stage || steps.length < 2) return;

      /* Where the page has to be for step `i` to be the active one — the inverse
         of the progress sum below, aimed at the middle of that step's slice so a
         click never lands on a boundary. */
      const scrollTop = () => window.scrollY + track.getBoundingClientRect().top;
      /* The distance the page moves while the stage stays pinned — measured
         from the STAGE, not from window.innerHeight.

         Both the track and the stage are sized in `svh`. `window.innerHeight`
         is the live visual viewport, which on a phone grows to roughly `lvh`
         the moment the address bar hides. Subtracting one from the other mixes
         units: `travel` came out short by an address-bar height, so `progress`
         reached 1 before the stage actually unpinned and the last stretch of
         the track changed nothing at all — a dead band sitting exactly on the
         seam with the next section. Reading the stage keeps both sides in the
         same unit, whatever the browser chrome is doing. */
      const travelOf = () => track.offsetHeight - stage.offsetHeight;
      const positionOf = (i: number) => scrollTop() + (travelOf() * (i + 0.5)) / steps.length;
      arrows.forEach((btn) => {
        btn.addEventListener('click', () => {
          const next = current + Number(btn.dataset.dir);
          if (next < 0 || next >= steps.length) return;
          section.removeAttribute('data-hint');
          window.scrollTo({ top: positionOf(next), behavior: 'smooth' });
        });
      });
      // The hint runs until the visitor moves off the first step.
      section.setAttribute('data-hint', '');

      let current = -1;
      let queued = false;

      const apply = () => {
        queued = false;
        const rect = track.getBoundingClientRect();
        const travel = travelOf();
        const progress = travel > 0 ? Math.min(Math.max(-rect.top / travel, 0), 1) : 0;
        // The clamp is what keeps the last step in range at progress === 1.
        // (An epsilon pair used to sit here that cancelled itself out exactly.)
        const index = Math.min(steps.length - 1, Math.floor(progress * steps.length));

        if (index === current) return;
        current = index;
        steps.forEach((el, i) => {
          const on = i === index;
          el.classList.toggle('is-active', on);
          // Only the visible step is exposed; the others are duplicates to a reader.
          if (on) el.removeAttribute('aria-hidden');
          else el.setAttribute('aria-hidden', 'true');
          /* `inert` as well as aria-hidden, because of the link inside.
             `visibility: hidden` does take an element out of the tab order — but
             it is transitioned here with a 0.55s delay, so during every swap two
             steps are briefly visible and BOTH their links are tabbable. A real
             keyboard test found eleven reachable "Αναλυτικά" links where there
             should have been one. `inert` is not transitioned and not negotiable.
             Set from JS only: without it the plain stacked fallback would have
             five sixths of itself switched off. */
          el.toggleAttribute('inert', !on);
        });
        if (count) count.textContent = String(index + 1);
        if (index > 0) section.removeAttribute('data-hint');
        arrows.forEach((btn) => {
          const dir = Number(btn.dataset.dir);
          btn.disabled = dir < 0 ? index === 0 : index === steps.length - 1;
        });
      };

      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      teardown.push(() => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      });
      apply();
    });
  }

  function unbind() {
    while (teardown.length) teardown.pop()?.();
  }

  bind();
  document.addEventListener('astro:after-swap', bind);
  document.addEventListener('astro:before-swap', unbind);
</script>
