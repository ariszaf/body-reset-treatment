---
/** Button — primary/secondary/outline, token sizing, hover lift (catalog: animate.md). */
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline';
  type?: 'button' | 'submit';
  class?: string;
  [key: `data-${string}`]: string | boolean | undefined;
}
/* Rest props are forwarded so callers can attach hooks (data-booking, aria-*,
   rel, target) without the component needing to know about each one. */
const { href, variant = 'primary', type = 'button', class: className, ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class={`btn btn--${variant} text-button ${className ?? ''}`} href={href} type={href ? undefined : type} {...rest}>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-block;
    padding: 0.7em 1.5em;              /* em — scales with the button's text */
    border-radius: var(--radius-base);
    border: 1px solid transparent;
    text-decoration: none;
    cursor: pointer;
  }
  /* Dark site: the "primary" surface is the LIGHT one — text on it is the page ink. */
  .btn--primary { background: var(--color-primary); color: var(--color-on-primary); }
  .btn--secondary { background: var(--color-secondary); color: var(--color-on-primary); }
  .btn--outline { background: transparent; color: var(--color-primary); border-color: color-mix(in srgb, var(--color-primary) 45%, transparent); }

  @media (hover: hover) {
    .btn { transition: transform var(--transition-base), box-shadow var(--transition-base), background-color var(--transition-base), border-color var(--transition-base), color var(--transition-base); }
    .btn:hover { transform: translateY(-2px); box-shadow: var(--shadow-elevated); }
    .btn--primary:hover { background: var(--color-primary-light); }
    .btn--outline:hover { background: var(--color-primary); color: var(--color-on-primary); border-color: var(--color-primary); }
  }
</style>
