---
/**
 * Contact form. WHERE IT POSTS is `site.formEndpoint`; leave that empty and it
 * falls back to the Polarzee hosted endpoint (forms.polarzee.com), which is the
 * factory default and needs the domain registered there.
 *
 * The token dance is Polarzee's, not a general requirement: GET a one-time token
 * on mount, POST it back with the payload and a honeypot. A CUSTOM endpoint gets
 * the plain JSON and nothing else — no token round-trip, because there is no
 * reason to assume someone else's server issues one. That is the only behaviour
 * that changes with the address.
 *
 * NO API key, NO third-party mail service either way. Server limits: name ≤120,
 * email ≤200, phone ≤60, subject ≤200, message ≤5000 (mirrored as maxlength for
 * instant UX). Failures are reported through error-logger's logFormError.
 */
import { site } from '../content/site';

const POLARZEE = 'https://forms.polarzee.com/';
const endpoint = (site as { formEndpoint?: string }).formEndpoint?.trim() || POLARZEE;
const usesPolarzee = endpoint === POLARZEE;
---

<form
  class="contact-form"
  novalidate
  data-site-key={site.formSiteKey}
  data-endpoint={endpoint}
  data-token-flow={usesPolarzee ? '' : undefined}
>
  <div class="field">
    <label for="cf-name">Ονοματεπώνυμο</label>
    <input id="cf-name" name="name" type="text" required autocomplete="name" maxlength="120" />
  </div>
  <div class="field">
    <label for="cf-email">Email</label>
    <input id="cf-email" name="email" type="email" required autocomplete="email" maxlength="200" />
  </div>
  <div class="field">
    <label for="cf-phone">Τηλέφωνο</label>
    <input id="cf-phone" name="phone" type="tel" autocomplete="tel" maxlength="60" />
  </div>
  <div class="field">
    <label for="cf-message">Μήνυμα</label>
    <textarea id="cf-message" name="message" rows="4" required maxlength="5000"></textarea>
  </div>
  {/* honeypot: real visitors never see or fill this; bots that do are dropped */}
  <input class="cf-hp" type="text" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button class="btn-submit text-button" type="submit">Αποστολή</button>
  <p class="form-status text-caption" role="status" aria-live="polite"></p>
</form>

<style>
  /* RULED LINES, NOT BOXES. The default form look, a bordered rounded box per
     field plus a filled button that lifts on hover, is the one place a site
     stops speaking its own language and starts speaking the browser's. This
     brand is built from hairlines and light weights, so the fields are hairlines
     too: no box, no radius, no shadow, no fill.

     Everything below is a token. Nothing here is a form style, it is the page
     style applied to a form. */
  .contact-form { display: grid; gap: var(--stack-lg); max-width: 34rem; }
  .field { display: grid; gap: 0.5rem; }

  label {
    font-size: var(--text-label);          /* 17px floor */
    font-weight: 400;                      /* not bold: it labels, it does not shout */
    letter-spacing: 0.04em;
    color: var(--color-muted);
  }

  input,
  textarea {
    font: inherit;
    font-size: var(--text-card-body);      /* 18px: what you type is body copy */
    color: var(--color-text);
    background: none;                      /* the page shows through */
    border: 0;
    border-block-end: 1px solid var(--color-border);
    border-radius: 0;
    /* Weighted to the bottom: what you type should sit just above its rule,
       not float in the middle of a 44px box. The height stays for the finger. */
    padding: 0.95em 0 0.45em;              /* em, so it tracks the field's text */
    min-block-size: 2.75rem;               /* ≥44px for a finger */
    appearance: none;
    transition: border-color var(--transition-base);
  }
  textarea { resize: vertical; line-height: 1.55; }

  /* The line warms and thickens on focus. Two device pixels is enough to read
     as "here" without becoming a frame. */
  input:focus,
  textarea:focus {
    outline: none;
    border-block-end-color: var(--color-accent);
    box-shadow: 0 1px 0 0 var(--color-accent);
  }
  input:focus-visible,
  textarea:focus-visible { border-block-end-color: var(--color-accent); }

  /* honeypot: off-screen, never shown */
  .cf-hp { position: absolute; left: -9999px; top: -9999px; width: 1px; height: 1px; opacity: 0; pointer-events: none; }

  /* The button is a word with a rule under it, like every other link on the
     site. It is the only control here, so it does not need weight to be found. */
  .btn-submit {
    justify-self: start;
    margin-block-start: var(--stack-sm);
    font-size: var(--text-label);          /* 17px floor */
    font-weight: 400;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text);
    background: none;
    border: 0;
    border-block-end: 1px solid var(--color-accent);
    border-radius: 0;
    padding: 0.6em 0 0.35em;
    min-block-size: 2.75rem;
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base);
  }
  .btn-submit[disabled] { color: var(--color-muted); border-block-end-color: var(--color-border); cursor: default; }
  @media (hover: hover) {
    .btn-submit:not([disabled]):hover { color: var(--color-accent); }
  }

  .form-status:empty { display: none; }
</style>

<script>
  import { logFormError } from '../scripts/error-logger';

  const GENERIC = 'Δεν ήταν δυνατή η αποστολή του μηνύματος αυτή τη στιγμή. Δοκιμάστε ξανά αργότερα ή επικοινωνήστε μαζί μας απευθείας.';

  const form = document.querySelector<HTMLFormElement>('.contact-form');
  // Where to post and whether that address issues one-time tokens. Both come
  // from the markup, so a change of endpoint is a change of one data file.
  const ENDPOINT = form?.dataset.endpoint || 'https://forms.polarzee.com/';
  const TOKEN_FLOW = form?.dataset.tokenFlow !== undefined;
  const status = form?.querySelector<HTMLElement>('.form-status');
  const btn = form?.querySelector<HTMLButtonElement>('.btn-submit');
  const honeypot = form?.querySelector<HTMLInputElement>('[name="company_url"]');
  const SITE_KEY = form?.dataset.siteKey || '';

  let token = '';
  const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function getToken() {
    try {
      const r = await fetch(ENDPOINT);
      const d = await r.json();
      if (d?.ok && d.token) token = d.token;
    } catch { /* offline / blocked — retried on submit */ }
  }
  // ON FIRST TOUCH, not on mount. The token is valid 2s–2h and the server
  // rejects anything submitted within 2s of issuing one, so it has to be asked
  // for before the submit — but asking on page load meant every visitor who
  // never touches the form still paid for a cross-origin request, and while the
  // domain is not registered at the endpoint that request FAILS and prints CORS
  // errors in the console of every visit. The launch gate caught it: three
  // errors on a page nobody had interacted with.
  // Focusing a field is the earliest honest signal, and filling one in takes
  // far longer than the two seconds the server wants.
  if (form && TOKEN_FLOW) {
    form.addEventListener('focusin', () => { if (!token) getToken(); }, { once: true });
  }

  async function post(fields: Record<string, string>) {
    const res = await fetch(ENDPOINT, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(TOKEN_FLOW ? { ...fields, _token: token } : fields),
    });
    const data = await res.json().catch(() => ({}));
    return { res, data };
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const f = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
    if (!f.name || !f.email || !f.message) {
      if (status) status.textContent = 'Συμπληρώστε τα υποχρεωτικά πεδία.';
      return;
    }
    const fields = {
      site: SITE_KEY,
      name: f.name || '', email: f.email || '',
      phone: f.phone || '', subject: f.subject || '',
      message: f.message || '',
      company_url: honeypot?.value || '',
    };

    if (btn) btn.disabled = true;
    if (status) status.textContent = 'Αποστολή…';
    try {
      if (TOKEN_FLOW && !token) await getToken();
      let { res, data } = await post(fields);

      // one retry on a token problem: too_fast → brief wait; else → fresh token
      if (res.status === 422 && data?.error === 'invalid_token') {
        if (data.reason === 'too_fast') await wait(2100);
        else await getToken();
        ({ res, data } = await post(fields));
      }

      if (res.ok && data?.ok) {
        if (status) status.textContent = 'Το μήνυμά σας εστάλη — θα επικοινωνήσουμε σύντομα.';
        form.reset();
        token = '';
        getToken();                         // pre-fetch a fresh token for the next enquiry
      } else if (res.status === 429) {
        if (status) status.textContent = 'Πολλές προσπάθειες — δοκιμάστε ξανά σε λίγο.';
      } else if (res.status === 422 && data?.error === 'validation') {
        if (status) status.textContent = 'Ελέγξτε τα στοιχεία σας και δοκιμάστε ξανά.';
      } else if (res.status === 422 && data?.error === 'invalid_token') {
        token = ''; getToken();
        if (status) status.textContent = 'Η σύνδεση έληξε — υποβάλετε ξανά.';
      } else {
        logFormError('contact', `HTTP ${res.status} ${data?.error || ''}`.trim());
        if (status) status.textContent = GENERIC;   // 502 / 5xx / unexpected
      }
    } catch (err) {
      logFormError('contact', err instanceof Error ? err.message : String(err));
      if (status) status.textContent = GENERIC;      // network error
    } finally {
      if (btn) btn.disabled = false;
    }
  });
</script>
