---
/**
 * Breadcrumbs — BreadcrumbList JSON-LD ONLY. Nothing is drawn on the page.
 *
 * The visible trail («Αρχική › Θεραπείες») was removed at the client's request:
 * they do not want a directory path on the page. The structured data stays, and
 * that is not a loophole — the two do different jobs. On the page the trail was
 * a second, smaller navigation for a site with three sections and a menu that
 * is always on screen. In a search result the same data draws the path UNDER
 * the link, which is where it earns its keep and where nobody has to look at it
 * until it is useful.
 *
 * Keep placing it at the top of every page EXCEPT the homepage — it renders
 * nothing, so where it sits only affects where the script tag lands.
 *
 * Auto-derives from the current URL via pages.ts; pass `trail` to override
 * (e.g. treatment pages: [{name:'Θεραπείες',href:'/therapeies/'},{name:'Cupping'}]).
 */
import { site } from '../content/site';
import { pages } from '../content/pages';

interface Crumb { name: string; href?: string }
interface Props { trail?: Crumb[] }

const { trail } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '').replace(/^\//, '');
const auto: Crumb[] = path
  ? path.split('/').map((seg, i, all) => {
      const slug = all.slice(0, i + 1).join('/');
      const page = pages.find((p) => p.slug === slug);
      return { name: page?.nameEl ?? seg, href: i < all.length - 1 ? `/${slug}/` : undefined };
    })
  : [];

const crumbs: Crumb[] = [{ name: 'Αρχική', href: '/' }, ...(trail ?? auto)];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: crumbs.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---

{crumbs.length > 1 && <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />}
