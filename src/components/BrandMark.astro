---
/**
 * BrandMark — the client's logotype, used as-is.
 *
 * Source: BODY RESET_logo_final.svg (Illustrator export). Nothing is redrawn —
 * the path data is byte-for-byte the source's. `scripts/make-logo-parts.py`
 * removes the black backing rect, binds the hard-coded #FFFFFF to currentColor,
 * splits the four top-level children into SIBLING groups .lg-wave / .lg-slash /
 * .lg-word / .lg-sub, and carries the slash's measured length as --slash-len.
 * The viewBox (79 130.6 267.9 181.3) trims the empty margin only.
 *
 * Siblings matter: an earlier build left the last three nested INSIDE .lg-wave,
 * so the wave's reveal mask clipped the entire logotype along with it.
 *
 * Inlined (?raw) rather than referenced with <img src>: an <img> is an isolated
 * document and would ignore currentColor, forcing two colour variants of the
 * same artwork that would drift apart.
 *
 * Props:
 *   title    accessible name; pass '' to mark it decorative
 *   draw     re-form the mark on mount — the wave opens, the slash traces, the
 *            wordmark settles. With view transitions the header is re-rendered
 *            on every navigation, so a plain CSS animation replays by itself:
 *            no JavaScript, no event listener, nothing to hold the page back.
 */
import logoParts from '../assets/logo-parts.svg?raw';

interface Props {
  title?: string;
  draw?: boolean;
  class?: string;
}
const { title = 'Body Reset Treatment', draw = false, class: className } = Astro.props;

// Decorative instances drop role/aria-label and go aria-hidden, so the mark is
// not announced twice next to a link that already has a label.
const svg = title
  ? logoParts.replace('aria-label="Body Reset Treatment"', `aria-label="${title}"`)
  : logoParts.replace('role="img" aria-label="Body Reset Treatment"', 'aria-hidden="true" focusable="false"');
---

<span class={`brandmark ${draw ? 'brandmark--draw' : ''} ${className ?? ''}`} set:html={svg} />

<style>
  .brandmark { display: block; color: inherit; }
  /* :global reaches the injected SVG — set:html content is not scoped.
     (Valid here because this block is scoped; inside an is:global block it
     would silently invalidate the selector.) */
  .brandmark :global(svg) {
    display: block;
    width: 100%;
    height: auto;   /* viewBox supplies the ratio → no layout shift */
  }

  /* ------------------------------ the draw ------------------------------ */
  /* The wave is a FILLED path with no stroke, so stroke-dashoffset cannot
     apply to it — it is drawn with a mask that grows. The slash IS a stroked
     <line>, so it gets a real trace. Two techniques, one gesture. */
  /* Two knobs for the caller, so the choreography lives in ONE place and the
     bar and the hero cannot drift into two different gestures:
       --draw-delay  when the whole sequence starts (wait out an intro veil)
       --draw-speed  multiplier on every duration AND offset — a mark ten times
                     the size of the bar's wants the same gesture, slower.  */
  .brandmark--draw {
    --u: var(--draw-speed, 1);
    --t0: var(--draw-delay, 0s);
  }
  .brandmark--draw :global(.lg-wave) {
    -webkit-mask-image: linear-gradient(#000, #000);
            mask-image: linear-gradient(#000, #000);
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    animation: bmWave calc(0.85s * var(--u)) cubic-bezier(0.65, 0, 0.35, 1) var(--t0) both;
  }
  .brandmark--draw :global(.lg-slash line) {
    stroke-dasharray: var(--slash-len, 217);
    animation: bmSlash calc(0.6s * var(--u)) cubic-bezier(0.4, 0, 0.2, 1)
               calc(var(--t0) + 0.42s * var(--u)) both;
  }
  .brandmark--draw :global(.lg-word) {
    animation: bmWord calc(0.5s * var(--u)) var(--reveal-ease)
               calc(var(--t0) + 0.72s * var(--u)) both;
  }
  /* "TREATMENT" lands last — it is the quietest line in the mark. */
  .brandmark--draw :global(.lg-sub) {
    animation: bmWord calc(0.5s * var(--u)) var(--reveal-ease)
               calc(var(--t0) + 0.92s * var(--u)) both;
  }

  @keyframes bmWave {
    from { -webkit-mask-size: 0% 100%; mask-size: 0% 100%; }
    to   { -webkit-mask-size: 100% 100%; mask-size: 100% 100%; }
  }
  @keyframes bmSlash {
    from { stroke-dashoffset: var(--slash-len, 217); }
    to   { stroke-dashoffset: 0; }
  }
  @keyframes bmWord {
    from { opacity: 0; transform: translateY(5px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .brandmark--draw :global(.lg-wave),
    .brandmark--draw :global(.lg-slash line),
    .brandmark--draw :global(.lg-word),
    .brandmark--draw :global(.lg-sub) { animation: none; }
  }
</style>
