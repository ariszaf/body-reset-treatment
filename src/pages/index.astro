---
/**
 * Homepage.
 * hero → the treatments (pinned showcase) → how it works (rail).
 * The appointment block lives in the footer, on every page.
 * The wave rule (the logo's own line) marks the joints.
 *
 * ONE photograph, in the hero only. The service is mobile — the therapist comes
 * to the client — so there is no premises to show, and repeating the same
 * interior down the page would both bore and mislead. Everything below the hero
 * is carried by type and by the line marks in BrandIcon.
 *
 * No prices anywhere: every path leads to an appointment.
 */
import Layout from '@layouts/Layout.astro';
import WaveRule from '@components/WaveRule.astro';
import HeroFullBleed from '@components/sections/HeroFullBleed.astro';
import PinnedSteps from '@components/sections/PinnedSteps.astro';
import StepsRail from '@components/sections/StepsRail.astro';
import Container from '@components/Container.astro';
import { services } from '@content/services';
import { images, heroSequence, serviceImages } from '@content/images';

/* What "at home" actually means in practice — the three things someone wants
   answered before they let a stranger into their flat. */
const howItWorks = [
  {
    icon: 'home' as const,
    title: 'Ερχόμαστε στον χώρο σας',
    text: 'Η συνεδρία πραγματοποιείται στο δικό σας περιβάλλον. Δεν χρειάζεται να ταλαιπωρηθείτε με μετακινήσεις πριν ή, το κυριότερο, μετά τη θεραπεία σας.',
  },
  {
    icon: 'table' as const,
    title: 'Αναλαμβάνουμε τον εξοπλισμό',
    text: 'Επαγγελματικό κρεβάτι, καθαρά λινά και ποιοτικά έλαια έρχονται μαζί μας. Το μόνο που χρειαζόμαστε είναι ένας ελεύθερος χώρος περίπου δύο επί δύο μέτρα.',
  },
  {
    icon: 'one' as const,
    title: 'Απόλυτη αφοσίωση',
    text: 'Δεν υπάρχει επόμενος πελάτης στην αναμονή. Ο χρόνος που κλείνετε είναι αποκλειστικά δικός σας, χωρίς καμία απολύτως βιασύνη.',
  },
];

/* The showcase: the treatments as they arrive on the pinned stage. The name in
   the brand's accent, the one-line version, and that treatment's own frame from
   the shoot. The category label that used to sit above the name is gone — its
   colour moved onto the name itself.
   Built from services.ts + images.ts so nothing is restated here: this section
   and the machine-readable llms.txt can never disagree about what is offered. */
/* The three lines the «Ποιοι Είμαστε» page is worth summarising by, drawn
   word-for-word from the client's own copy — the years and where they were
   spent, the refusal to run a protocol, and the equipment arriving with us.
   Nothing here is written by us, so nothing here can drift from that page. */
const highlights = [
  'Περισσότερα από 9 χρόνια σε φυσικοθεραπευτικά κέντρα, δομές αποκατάστασης αθλητών και premium spa.',
  'Καμία τυποποιημένη συνεδρία: κάθε θεραπεία προσαρμόζεται στις ανάγκες και τους στόχους του κάθε ανθρώπου.',
  'Πλήρης επαγγελματικός εξοπλισμός στον δικό σας χώρο, χωρίς μετακινήσεις.',
];

const showcase = services.map((s) => ({
  title: s.title,
  text: s.short,
  image: serviceImages[s.slug],
  href: `/therapeies/${s.slug}/`,
}));
---

<Layout slug="">
  <HeroFullBleed
    slides={heroSequence.slice(0, 1)}
    title="Αθλητικό & σουηδικό μασάζ κατ’ οίκον στην Αθήνα"
    ink="dark"
    scrim={false}
    markY="33%"
    markYPortrait="50%"
    nextAnchor="therapeies"
  />

  {/* The treatments take the pinned stage — first thing after the photograph,
      one at a time, each with its own frame from the shoot. */}
  <PinnedSteps id="therapeies" eyebrow="Οι θεραπείες" steps={showcase} />

  {/* «How it works» keeps its content but changes shape: three across on a
      large screen, a swipeable rail below that. No `id` — an anchor may exist
      only once on a page, and the cue already points at the treatments. */}
  <StepsRail eyebrow="Πώς λειτουργεί" steps={howItWorks} />

  {/* The last thing before the footer: who is actually turning up. A mobile
      service asks someone to let a stranger into their home, and the site had
      been answering everything except that. Three lines and the face, then out
      to the page that says it properly — not a second copy of it. */}
  <section class="py-section about">
    <Container>
      <div class="about-grid">
        <figure class="about-media reveal reveal-up">
          <img
            src={images.therapist.src}
            alt={images.therapist.alt}
            width={images.therapist.width}
            height={images.therapist.height}
            loading="lazy"
            decoding="async"
          />
        </figure>

        <div class="about-copy">
          <p class="text-eyebrow reveal reveal-up">Ποιοι είμαστε</p>
          <h2 class="text-section-title about-title reveal reveal-up">
            Το Body Reset Treatment δεν είναι απλώς μια συνεδρία μασάζ
          </h2>
          <ul class="about-list reveal-stagger">
            {highlights.map((h) => (
              <li class="text-card-body about-item reveal reveal-up">{h}</li>
            ))}
          </ul>
          <p class="about-more reveal reveal-up">
            <a class="about-link" href="/poioi-eimaste/">Περισσότερα για εμάς<span aria-hidden="true"> →</span></a>
          </p>
        </div>
      </div>
    </Container>
  </section>


</Layout>

<style>
  .about { background: var(--color-alt); }
  .about-grid { display: grid; gap: var(--stack-xl); }
  .about-media {
    margin: 0;
    aspect-ratio: 2 / 3;               /* the frame's own ratio — no crop */
    overflow: hidden;
    background: var(--color-bg);
  }
  .about-media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .about-title { margin-block-start: var(--stack-md); max-width: 22ch; }
  .about-list { list-style: none; margin: var(--stack-lg) 0 0; padding: 0; }
  /* A rule per line, the same mark the treatment pages use for their lists —
     the brand's vocabulary is hairlines, not discs. */
  .about-item {
    padding-block: var(--stack-md);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .about-item:last-child { border-bottom: 1px solid var(--color-border); }

  .about-more { margin-block-start: var(--stack-lg); }
  .about-link {
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-bg));
    text-decoration: none;
    font-size: var(--text-label);      /* 17px floor */
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    display: inline-flex;
    padding-block: 0.5em 0.15em;
    min-block-size: 2.75rem;           /* ≥44px for a finger */
    align-items: flex-end;
    margin-block-end: -0.55rem;
  }
  @media (hover: hover) {
    .about-link { transition: color var(--transition-base), border-color var(--transition-base); }
    .about-link:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  }

  @media (min-width: 64rem) {
    /* The portrait keeps the narrower column and the words the wider one —
       the reverse of the treatments stage above it, so the two do not read as
       the same layout twice. */
    .about-grid {
      grid-template-columns: minmax(0, 0.55fr) minmax(0, 1fr);
      gap: var(--stack-xl);
      align-items: center;
    }
    .about-grid > * { min-width: 0; }
  }
</style>
