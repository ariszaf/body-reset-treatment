---
/**
 * One page per treatment, generated from services.ts.
 *
 * A dynamic route rather than six hand-written files: six copies of the same
 * layout would drift, and adding a seventh treatment would mean remembering to
 * create a page as well as a data entry. Here the data IS the page list.
 *
 * `getStaticPaths` runs at build time — these are six real HTML files, with
 * their own titles, canonicals and breadcrumbs. Nothing is rendered on request.
 *
 * Every page also emits a `Service` JSON-LD tied to the business, which is what
 * lets a search engine or an assistant answer "do they do cupping?" with the
 * page rather than with a guess.
 */
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Button from '@components/Button.astro';
import WaveRule from '@components/WaveRule.astro';
import { services } from '@content/services';
import { serviceImages } from '@content/images';
import { site } from '@content/site';
import { booking, bookingAttrs } from '@lib/booking';

export function getStaticPaths() {
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: {
      service,
      // Everything else on offer. A visitor who lands here from a search has
      // seen one treatment and no reason to believe there are five more —
      // showing them beats a "back" link they will not press.
      others: services.filter((_, n) => n !== i),
    },
  }));
}

const { service, others } = Astro.props;
const photo = serviceImages[service.slug];
const paragraphs = service.description.split('\n\n');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.short,
  areaServed: site.serviceArea,
  provider: { '@type': 'LocalBusiness', name: site.name, url: site.url },
  url: new URL(`/therapeies/${service.slug}/`, site.url).href,
};
---

<Layout slug={`therapeies/${service.slug}`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <section class="py-section svc">
    <Container>
      <Breadcrumbs trail={[{ name: 'Θεραπείες', href: '/therapeies/' }, { name: service.title }]} />

      <div class="svc-head">
        <div class="svc-copy">
          <h1 class="text-h1 svc-title reveal reveal-up">{service.title}</h1>
          <p class="text-lead svc-short reveal reveal-up">{service.short}</p>
        </div>

        <figure class="svc-media reveal reveal-up">
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </figure>
      </div>

      <div class="svc-body reveal reveal-up">
        {paragraphs.map((p) => <p class="text-card-body svc-para">{p}</p>)}
        {service.durations && (
          <p class="svc-durations text-label">Διάρκειες: {service.durations.join(' · ')}</p>
        )}
      </div>

      <div class="svc-cta reveal reveal-up">
        <Button {...bookingAttrs}>{booking.label}</Button>
        <p class="svc-hint text-caption">{booking.hint}</p>
      </div>
    </Container>
  </section>

  <WaveRule />

  <section class="py-section svc-near">
    <Container>
      <p class="text-eyebrow reveal reveal-up">Οι υπόλοιπες θεραπείες</p>
      <ul class="svc-near-list reveal-stagger">
        {others.map((o) => (
          <li class="reveal reveal-up">
            <a class="svc-near-card" href={`/therapeies/${o.slug}/`}>
              <figure class="svc-near-media">
                <img
                  src={serviceImages[o.slug].src}
                  alt={serviceImages[o.slug].alt}
                  width={serviceImages[o.slug].width}
                  height={serviceImages[o.slug].height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <span class="svc-near-name text-card-title">{o.title}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="svc-near-all reveal reveal-up">
        <a class="svc-near-link" href="/therapeies/">Όλες οι θεραπείες<span aria-hidden="true"> →</span></a>
      </p>
    </Container>
  </section>
</Layout>

<style>
  .svc-head { display: grid; gap: var(--stack-lg); }
  .svc-title { color: var(--color-accent); }
  .svc-short { margin-block-start: var(--stack-md); max-width: 34rem; color: var(--color-muted); }

  .svc-media {
    margin: 0;
    aspect-ratio: 2 / 3;              /* the photographs' own ratio — no crop */
    overflow: hidden;
    background: var(--color-alt);
  }
  .svc-media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .svc-body { margin-block-start: var(--stack-xl); max-width: 40rem; }
  .svc-para + .svc-para { margin-block-start: var(--stack-md); }
  .svc-durations { margin-block-start: var(--stack-lg); color: var(--color-accent); }
  .svc-cta { margin-block-start: var(--stack-xl); }
  .svc-hint { margin-block-start: var(--stack-sm); }

  @media (min-width: 64rem) {
    .svc-head { grid-template-columns: 1fr 0.72fr; gap: var(--stack-xl); align-items: center; }
    .svc-media { max-height: 62dvh; height: 62dvh; width: auto; margin-inline-start: auto; }
  }

  /* ------------------------------ neighbours ---------------------------- */
  .svc-near { background: var(--color-alt); }
  .svc-near-list {
    list-style: none;
    margin: var(--stack-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--stack-lg);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 48rem) { .svc-near-list { grid-template-columns: repeat(5, 1fr); gap: var(--stack-md); } }

  .svc-near-card { display: block; text-decoration: none; color: inherit; }
  .svc-near-media {
    margin: 0;
    aspect-ratio: 2 / 3;               /* the photographs' own ratio — no crop */
    overflow: hidden;
    background: var(--color-bg);
  }
  .svc-near-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .svc-near-name {
    display: block;
    margin-block-start: var(--stack-sm);
    color: var(--color-accent);
  }
  .svc-near-all { margin-block-start: var(--stack-lg); }
  .svc-near-link {
    color: color-mix(in srgb, var(--color-text) 78%, var(--color-bg));
    text-decoration: none;
    font-size: var(--text-label);      /* 17px floor */
    font-weight: 400;
    border-bottom: 1px solid color-mix(in srgb, var(--color-text) 22%, transparent);
    display: inline-flex;
    padding-block: 0.5em 0.15em;
    min-block-size: 2.75rem;             /* ≥44px for a finger */
    align-items: flex-end;
    margin-block-end: -0.55rem;
  }
  @media (hover: hover) {
    .svc-near-media img { transition: transform 0.6s var(--reveal-ease); }
    .svc-near-card:hover .svc-near-media img { transform: scale(1.04); }
    .svc-near-link { transition: color var(--transition-base), border-color var(--transition-base); }
    .svc-near-link:hover { color: var(--color-accent); border-bottom-color: var(--color-accent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-near-card:hover .svc-near-media img { transform: none; }
  }
</style>
