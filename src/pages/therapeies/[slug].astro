---
/**
 * One page per treatment, generated from services.ts.
 *
 * A dynamic route rather than six hand-written files: six copies of the same
 * layout would drift, and adding a seventh treatment would mean remembering to
 * create a page as well as a data entry. Here the data IS the page list.
 *
 * `getStaticPaths` runs at build time — these are six real HTML files, with
 * their own titles, canonicals and breadcrumbs. Nothing is rendered on request.
 *
 * Every page also emits a `Service` JSON-LD tied to the business, which is what
 * lets a search engine or an assistant answer "do they do cupping?" with the
 * page rather than with a guess.
 */
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Button from '@components/Button.astro';
import WaveRule from '@components/WaveRule.astro';
import { services } from '@content/services';
import { serviceImages } from '@content/images';
import { site } from '@content/site';
import { booking, bookingAttrs } from '@lib/booking';

export function getStaticPaths() {
  return services.map((service, i) => ({
    params: { slug: service.slug },
    props: {
      service,
      // Everything else on offer. A visitor who lands here from a search has
      // seen one treatment and no reason to believe there are five more —
      // showing them beats a "back" link they will not press.
      others: services.filter((_, n) => n !== i),
    },
  }));
}

const { service, others } = Astro.props;
const photo = serviceImages[service.slug];
const paragraphs = service.description.split('\n\n');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: service.title,
  description: service.description,
  areaServed: site.serviceArea,
  provider: { '@type': 'LocalBusiness', name: site.name, url: site.url },
  url: new URL(`/therapeies/${service.slug}/`, site.url).href,
};
---

<Layout slug={`therapeies/${service.slug}`}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <section class="py-section svc">
    <Container>
      <Breadcrumbs trail={[{ name: 'Θεραπείες', href: '/therapeies/' }, { name: service.title }]} />

      <div class="svc-head">
        {/* Title AND description in the first column, beside the photograph.
            The description used to sit in a full-width band under the whole
            grid, which left the title alone next to a tall picture and pushed
            the words that explain it below the fold. Together they read as one
            introduction.

            `short` is not here: it is compressed from this very description
            and would be the same sentence twice, seconds apart. It earns its
            place on the showcase and the cards, where the full text is nowhere
            near it. */}
        <div class="svc-copy">
          <h1 class="text-h1 svc-title reveal reveal-up">{service.title}</h1>
          <div class="svc-body reveal reveal-up">
            {paragraphs.map((p) => <p class="text-card-body svc-para">{p}</p>)}
            {service.durations && (
              <p class="svc-durations text-label">Διάρκειες: {service.durations.join(' · ')}</p>
            )}
          </div>
        </div>

        <figure class="svc-media reveal reveal-up">
          <img
            src={photo.src}
            alt={photo.alt}
            width={photo.width}
            height={photo.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </figure>
      </div>

      {/* Three blocks, always in this order and never behind a control.

          The last of them is a contraindications list — who should not have
          this treatment. On a health page that is the one thing a visitor may
          need before they book and cannot be asked to go looking for, so there
          is no accordion here and nothing is collapsed on a phone. It is set in
          full ink rather than muted for the same reason. */}
      <div class="svc-detail">
        <section class="svc-block reveal reveal-up">
          <h2 class="text-eyebrow">Σε ποιους απευθύνεται</h2>
          <p class="text-card-body svc-block-text">{service.forWhom}</p>
        </section>

        <section class="svc-block reveal reveal-up">
          <h2 class="text-eyebrow">Οφέλη</h2>
          <ul class="svc-list">
            {service.benefits.map((b) => (
              <li class="text-card-body svc-item">{b}</li>
            ))}
          </ul>
        </section>

        <section class="svc-block svc-block--care reveal reveal-up">
          <h2 class="text-eyebrow">Αντενδείξεις</h2>
          <ul class="svc-list">
            {service.cautions.map((c) => (
              <li class="text-card-body svc-item">{c}</li>
            ))}
          </ul>
          <p class="svc-note text-caption">
            Αν κάτι από τα παραπάνω σας αφορά, πείτε το μας πριν το ραντεβού.
            Προσαρμόζουμε ή προτείνουμε άλλη θεραπεία.
          </p>
        </section>
      </div>

      <div class="svc-cta reveal reveal-up">
        <Button {...bookingAttrs}>{booking.label}</Button>
      </div>
    </Container>
  </section>

  <WaveRule />

  <section class="py-section svc-near">
    <Container>
      {/* No «Όλες οι θεραπείες» link under this grid. There are six treatments,
          the visitor is standing on one and the other five are right here — the
          link led to a page whose entire contents they had just been shown. */}
      <p class="text-eyebrow reveal reveal-up">Οι υπόλοιπες θεραπείες</p>
      <ul class="svc-near-list reveal-stagger">
        {others.map((o) => (
          <li class="reveal reveal-up">
            <a class="svc-near-card" href={`/therapeies/${o.slug}/`}>
              <figure class="svc-near-media">
                <img
                  src={serviceImages[o.slug].src}
                  alt={serviceImages[o.slug].alt}
                  width={serviceImages[o.slug].width}
                  height={serviceImages[o.slug].height}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <span class="svc-near-name text-card-title">{o.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </Container>
  </section>
</Layout>

<style>
  .svc-head { display: grid; gap: var(--stack-lg); }
  .svc-title { color: var(--color-accent); }

  .svc-media {
    margin: 0;
    aspect-ratio: 2 / 3;              /* the photographs' own ratio — no crop */
    overflow: hidden;
    background: var(--color-alt);
  }
  .svc-media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .svc-body { margin-block-start: var(--stack-lg); max-width: 40rem; }
  .svc-para + .svc-para { margin-block-start: var(--stack-md); }
  .svc-durations { margin-block-start: var(--stack-lg); color: var(--color-accent); }

  /* ------------------------- for whom / benefits / cautions ------------- */
  .svc-detail { margin-block-start: var(--stack-xl); display: grid; gap: var(--stack-xl); }
  .svc-block { max-width: 40rem; padding-block-start: var(--stack-md); border-top: 1px solid var(--color-border); }
  .svc-block-text { margin-block-start: var(--stack-md); color: var(--color-muted); }
  .svc-list { list-style: none; margin: var(--stack-md) 0 0; padding: 0; display: grid; gap: var(--stack-sm); }
  /* A rule as the mark, not a disc — the brand's whole vocabulary is hairlines,
     and a column of bullets would be the one place on the site speaking
     otherwise. `em`, so it tracks the line it belongs to. */
  .svc-item { position: relative; padding-inline-start: 1.6em; color: var(--color-muted); }
  .svc-item::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.75em;
    inline-size: 0.9em;
    block-size: 1px;                       /* px — hairline */
    background: var(--color-accent);
  }
  /* Full ink, not muted: this is the block someone may have to act on. */
  .svc-block--care .svc-item { color: var(--color-text); }
  .svc-note { margin-block-start: var(--stack-md); }

  @media (min-width: 64rem) {
    .svc-detail { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--stack-lg); align-items: start; }
    .svc-block { max-width: none; }
  }
  .svc-cta { margin-block-start: var(--stack-xl); }

  @media (min-width: 64rem) {
    /* Top-aligned, not centred: the copy now starts at the title and runs
       down, so it should begin level with the top of the frame rather than
       float in the middle of it. */
    .svc-head { grid-template-columns: 1fr 0.72fr; gap: var(--stack-xl); align-items: start; }
    .svc-media { max-height: 62dvh; height: 62dvh; width: auto; margin-inline-start: auto; }
  }

  /* ------------------------------ neighbours ---------------------------- */
  .svc-near { background: var(--color-alt); }
  .svc-near-list {
    list-style: none;
    margin: var(--stack-lg) 0 0;
    padding: 0;
    display: grid;
    gap: var(--stack-lg);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 48rem) { .svc-near-list { grid-template-columns: repeat(5, 1fr); gap: var(--stack-md); } }

  .svc-near-card { display: block; text-decoration: none; color: inherit; }
  .svc-near-media {
    margin: 0;
    aspect-ratio: 2 / 3;               /* the photographs' own ratio — no crop */
    overflow: hidden;
    background: var(--color-bg);
  }
  .svc-near-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .svc-near-name {
    display: block;
    margin-block-start: var(--stack-sm);
    color: var(--color-accent);
  }
  @media (hover: hover) {
    .svc-near-media img { transition: transform 0.6s var(--reveal-ease); }
    .svc-near-card:hover .svc-near-media img { transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .svc-near-card:hover .svc-near-media img { transform: none; }
  }
</style>
