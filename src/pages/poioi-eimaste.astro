---
/**
 * Ποιοι Είμαστε.
 *
 * ONE photograph: the therapist. It arrived late and it is the right one — a
 * mobile service has no premises to show, so the honest subject of an about
 * page here is the person who turns up at your door. No interiors, no stock:
 * the rest of the page is still carried by type and line marks.
 *
 * COPY: supplied by the client, 31/07/2026, and used as written. It is the
 * first thing on this site to state a credential — "περισσότερων από 9 χρόνων"
 * — which is exactly why it had to come from them rather than from us.
 *
 * One word was changed and one section removed; both are in the commit message.
 */
import Layout from '@layouts/Layout.astro';
import Container from '@components/Container.astro';
import Button from '@components/Button.astro';
import WaveRule from '@components/WaveRule.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import { images } from '@content/images';
import { booking, bookingAttrs } from '@lib/booking';

/* What every session is built to do. A list, not a paragraph: four parallel
   outcomes read as four when they are set as four. */
const outcomes = [
  'Αποφόρτιση του μυϊκού συστήματος και ανακούφιση από την ένταση.',
  'Βελτίωση της κινητικότητας και της λειτουργικότητας του σώματος.',
  'Υποστήριξη της αποκατάστασης και της συνολικής σωματικής ευεξίας.',
  'Μια ολοκληρωμένη εμπειρία θεραπευτικής φροντίδας στον δικό σας χώρο, χωρίς μετακινήσεις και περιττή ταλαιπωρία.',
];

/* The three rules that follow from the approach above. Deliberately concrete:
   the section before it is the thinking, this is what the thinking commits to. */
const principles = [
  {
    title: 'Αξιολόγηση πριν από κάθε άγγιγμα',
    text: 'Καμία συνεδρία δεν ξεκινά αν δεν κατανοήσουμε πλήρως τι συμβαίνει, από πότε έχει ξεκινήσει η ενόχληση και υπό ποιες συνθήκες επιδεινώνεται.',
  },
  {
    title: 'Μία επίσκεψη τη φορά',
    text: 'Δεν υπάρχει επόμενος πελάτης στην αναμονή. Ο χρόνος που δεσμεύετε είναι ο χρόνος που πραγματικά απολαμβάνετε, χωρίς καμία βιασύνη.',
  },
  {
    title: 'Χωρίς πακέτα και δεσμεύσεις',
    text: 'Η επόμενη συνεδρία ορίζεται μόνο εάν κρίνεται πραγματικά απαραίτητη για την αποκατάστασή σας. Δεν προωθούμε προπληρωμένα πακέτα συνεδριών.',
  },
];
---

<Layout slug="poioi-eimaste">
  <section class="py-section page-head">
    <Container>
      <Breadcrumbs />
      <div class="page-head-grid">
        <div class="page-head-copy">
          <p class="text-eyebrow reveal reveal-up">Ποιοι είμαστε</p>
          <h1 class="text-h1 page-title reveal reveal-up">Σχετικά με το Body Reset Treatment</h1>
          <p class="text-lead page-lead reveal reveal-up">
            Το Body Reset Treatment δημιουργήθηκε με μία ξεκάθαρη φιλοσοφία: η πραγματική
            αποκατάσταση δεν αποτελεί πολυτέλεια, αλλά ουσιαστική ανάγκη του σώματος.
            Συνδυάζει την εξειδικευμένη θεραπευτική φροντίδα με την εμπειρία ενός premium
            spa, προσφέροντας φροντίδα υψηλών προδιαγραφών στην άνεση του δικού σας χώρου.
          </p>
          <p class="text-card-body page-body reveal reveal-up">
            Το brand αποτελεί την εξέλιξη περισσότερων από 9 χρόνων επαγγελματικής εμπειρίας
            στον χώρο της θεραπευτικής μάλαξης, της αθλητικής αποκατάστασης και του wellness.
            Η διαδρομή αυτή, μέσα από φυσικοθεραπευτικά κέντρα, δομές αποκατάστασης αθλητών
            και premium spa, διαμόρφωσε μια προσέγγιση που συνδυάζει επιστημονική γνώση,
            τεχνική ακρίβεια και υψηλά πρότυπα φροντίδας. Κάθε συνεδρία πραγματοποιείται με
            πλήρη επαγγελματικό εξοπλισμό, προσφέροντας μια ολοκληρωμένη θεραπευτική εμπειρία,
            χωρίς να χρειάζεται να μετακινηθείτε από τον χώρο σας.
          </p>
        </div>

        <figure class="page-portrait reveal reveal-up">
          <img
            src={images.therapist.src}
            alt={images.therapist.alt}
            width={images.therapist.width}
            height={images.therapist.height}
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
        </figure>
      </div>
    </Container>
  </section>

  <section class="py-section approach">
    <Container>
      <h2 class="text-section-title reveal reveal-up">Η προσέγγιση</h2>
      <p class="text-card-body approach-text reveal reveal-up">
        Κάθε σώμα είναι διαφορετικό και έχει τις δικές του ανάγκες. Για τον λόγο αυτό,
        δεν υπάρχουν προκαθορισμένα πρωτόκολλα ούτε τυποποιημένες συνεδρίες. Κάθε
        θεραπεία προσαρμόζεται αποκλειστικά στις ανάγκες, την καθημερινότητα και τους
        στόχους του κάθε ανθρώπου, με γνώμονα την ποιότητα, την ακρίβεια και το
        ουσιαστικό αποτέλεσμα.
      </p>
      <p class="text-card-body approach-text reveal reveal-up">
        Κάθε συνεδρία έχει σχεδιαστεί ώστε να συμβάλλει σε:
      </p>
      <ul class="outcomes reveal-stagger">
        {outcomes.map((o) => (
          <li class="outcome reveal reveal-up">
            <p class="text-card-body outcome-text">{o}</p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <WaveRule />

  <section class="py-section principles">
    <Container>
      <h2 class="text-section-title reveal reveal-up">Τι ισχύει πάντα</h2>
      <ol class="principles-list reveal-stagger">
        {principles.map((p, i) => (
          <li class="principle reveal reveal-up">
            <span class="principle-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="principle-body">
              <h3 class="text-card-title">{p.title}</h3>
              <p class="text-card-body principle-text">{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </Container>
  </section>

  <WaveRule />

  <section class="py-section closing">
    <Container>
      <p class="text-lead closing-text reveal reveal-up">
        Το Body Reset Treatment δεν είναι απλώς μια συνεδρία μασάζ. Αποτελεί μια
        ολοκληρωμένη εμπειρία επαγγελματικής θεραπευτικής φροντίδας, σχεδιασμένη για
        ανθρώπους που επιλέγουν την ποιότητα, την εξειδίκευση και το ουσιαστικό
        αποτέλεσμα.
      </p>
    </Container>
  </section>

  <section class="py-section detail-band">
    <Container>
      <div class="detail-copy">
        <p class="text-eyebrow reveal reveal-up">Ραντεβού</p>
        <h2 class="text-section-title reveal reveal-up">Κλείστε την πρώτη σας συνεδρία</h2>
        <p class="text-lead detail-lead reveal reveal-up">{booking.lead}</p>
        <div class="detail-action reveal reveal-up">
          <Button {...bookingAttrs}>{booking.label}</Button>
        </div>
      </div>
    </Container>
  </section>
</Layout>

<style>
  /* The header floats over the page with no background, so inner pages have to
     reserve the clearance the homepage gets for free from its full-bleed hero.
     Matches the bar: logo clamp(4.5rem,8.5vw,7.5rem) + the edge gutter twice. */
  .page-head { padding-block-start: calc(var(--space-section) + clamp(6.5rem, 9.5vw, 10.5rem)); }
  .page-title {
    margin-block-start: var(--stack-md);
    max-width: 24ch;
    text-transform: uppercase;
    font-weight: 200;
    letter-spacing: 0.1em;
    line-height: 1.35;
  }
  .page-lead { margin-block-start: var(--stack-lg); max-width: 44rem; color: var(--color-muted); }
  .page-body { margin-block-start: var(--stack-lg); max-width: 44rem; color: var(--color-muted); }

  .page-head-grid { display: grid; gap: var(--stack-xl); }
  .page-portrait {
    margin: 0;
    aspect-ratio: 2 / 3;               /* the frame's own ratio — no crop */
    overflow: hidden;
    background: var(--color-alt);
  }
  .page-portrait img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 64rem) {
    /* The portrait takes the narrower column. `min-width: 0` on both, or the
       long paragraph would push its own column past its share. */
    .page-head-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr); gap: var(--stack-xl); align-items: start; }
    .page-head-grid > * { min-width: 0; }
    .page-portrait { position: sticky; top: calc(var(--nav-bar-h) + var(--stack-lg)); }
  }

  /* ----------------------------- approach ---------------------------- */
  .approach { background: var(--color-alt); }
  .approach-text {
    margin-block-start: var(--stack-lg);
    max-width: 44rem;
    color: var(--color-muted);
  }

  /* Rules, not bullet glyphs. The brand's whole vocabulary is two hairlines;
     a row of discs would be the one place on the site speaking otherwise. */
  .outcomes { list-style: none; margin: var(--stack-lg) 0 0; padding: 0; }
  .outcome {
    padding-block: var(--stack-md);
    border-top: 1px solid var(--color-border);
    max-width: 44rem;
  }
  .outcome:last-child { border-bottom: 1px solid var(--color-border); }
  .outcome-text { color: var(--color-muted); }

  /* ---------------------------- principles --------------------------- */
  .principles-list { list-style: none; margin: var(--stack-lg) 0 0; padding: 0; }
  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: clamp(1.25rem, 3vw, 2rem);
    padding-block: clamp(1.75rem, 4vw, 2.5rem);
  }
  .principle + .principle { border-top: 1px solid var(--color-border); }
  .principle-num {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 200;
    letter-spacing: var(--heading-tracking);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--color-accent) 45%, transparent);
    user-select: none;
  }
  .principle-text { margin-block-start: var(--stack-sm); color: var(--color-muted); max-width: 44rem; }

  /* ----------------------------- closing ----------------------------- */
  /* The last word before the appointment. Full ink rather than muted — it is a
     statement, not supporting copy. */
  .closing-text { max-width: 44rem; }

  /* ---------------------------- detail band -------------------------- */
  .detail-band { background: var(--color-alt); }
  .detail-lead { margin-block-start: var(--stack-md); max-width: 38rem; color: var(--color-muted); }
  .detail-action { margin-block-start: var(--stack-lg); }
</style>
